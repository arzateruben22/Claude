# Rewards prototype — environment variables. docs/API.md §1 explains each one and lists
# every condition under which the server refuses to start.
#
# Copy to .env for local use (.env is ignored by git) and load it with
#   node --env-file=.env src/server.js
# or simply use `npm run dev`, which sets the three required values for local work.
#
# NEVER commit a real value. This file holds placeholders only.

# --- Required: there are no defaults ----------------------------------------

# google = real Sign in with Google.  dev = simulated sign-in with a code printed in the terminal.
AUTH_MODE=dev

# mock = sample platform data, labelled "simulated" everywhere.  live = real platform APIs (not built yet).
PLATFORM_MODE=mock

# The exact origin the app is opened at: scheme, host and port only. No path, no trailing slash.
# https://… everywhere except on this machine, where http://localhost, http://127.0.0.1 and http://[::1] are accepted.
APP_ORIGIN=http://localhost:8787

# --- Optional ----------------------------------------------------------------

# Listen address. With AUTH_MODE=dev, HOST must be a loopback address.
#HOST=127.0.0.1
#PORT=8787

# SQLite file. Must not be inside public/.
#DATABASE_PATH=./data/rewards.db

# Required when AUTH_MODE=google. Ends in .apps.googleusercontent.com
#GOOGLE_CLIENT_ID=

# Comma-separated addresses made admins ON FIRST START ONLY (when the database has no admin at all).
# Required for the first start with AUTH_MODE=google.
#ADMIN_EMAILS=owner@example.test

# Session lifetime in hours, 1–720.
#SESSION_TTL_HOURS=168

# How many reverse proxies sit in front of the server (0–3). Decides which address rate limits use.
#TRUST_PROXY_HOPS=0

# Fixed dev sign-in code for automated tests, at least 16 characters. Leave unset to get
# a new random code at every start (printed once in the terminal).
#DEV_LOGIN_CODE=
