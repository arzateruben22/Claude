{
  "name": "rewards-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Private single-screen dashboard with virtual (non-monetary) points, an audited ledger and honest verification states.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "test:coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage \"test/**/*.test.js\""
  },
  "dependencies": {
    "jose": "^6.2.17"
  }
}
