# Copy to .env and fill in. Never commit .env.

# Which data source: alpaca | massive | demo
SCANNER_PROVIDER=alpaca

# --- Alpaca (FREE) — alpaca.markets > sign up > Paper account > API keys ------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=delayed_sip   # free plan: full market, 15-min delay. "sip" = real-time (paid plan)
ALPACA_PAPER=true         # true for paper-account keys (recommended)

# --- Massive, formerly Polygon.io (PAID) — massive.com --------------------------
# Needs a Stocks plan that includes snapshots. If set, it's also used for float data.
MASSIVE_API_KEY=
MASSIVE_DELAY_MINUTES=0   # 15 if your plan is the delayed tier

# --- Phone alerts (optional) ----------------------------------------------------
NTFY_TOPIC=               # e.g. ruben-scanner-7f3k9 — pick something unguessable
DISCORD_WEBHOOK_URL=
