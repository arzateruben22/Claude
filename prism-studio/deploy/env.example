# Copy to .env.production on the server (never commit it). Generate secrets with: openssl rand -hex 32
DOMAIN=studio.example.com
POSTGRES_PASSWORD=
SESSION_SECRET=
# npm run owner:password -- "your passphrase"   (prints the hash)
OWNER_PASSWORD_HASH=
# turn on Connect buttons (seals platform tokens at rest)
INTEGRATIONS_KEY=
# platform apps (optional until you connect accounts; see INTEGRATIONS.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# nightly database backups (optional): the time and time zone they run in (default 03:15 UTC)
BACKUP_TZ=
BACKUP_AT=
