{
  "name": "prism-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Prism Studio: a phone-first content studio for five educational channels (series, episodes, Upload Desk, analytics, rewards and evolving channel worlds).",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "import:episodes": "tsx scripts/import-episodes.ts",
    "text:regenerate": "tsx scripts/regenerate-text.ts",
    "text:pack": "tsx scripts/posting-pack.ts",
    "covers": "tsx scripts/covers.ts",
    "snapshot": "tsx scripts/snapshot.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "owner:password": "tsx scripts/owner-password.ts",
    "wallpaper": "node scripts/wallpaper/render.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
