# Prism Studio environment (copy to .env.local; never commit real values)
DATABASE_URL=postgres://prism:prism-dev@localhost:5432/prism
TEST_DATABASE_URL=postgres://prism:prism-dev@localhost:5432/prism_test
# owner sign-in: generate with `npm run owner:password -- "your passphrase"`
OWNER_PASSWORD_HASH=
# 32+ random bytes, hex: `openssl rand -hex 32`
SESSION_SECRET=
# where rendered media and exports live (local disk adapter); S3 settings below switch to object storage
MEDIA_ROOT=./data/media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# the films/kits repo root, for importing episodes and running the cinema renderer
FILMS_REPO_ROOT=..
# paid generation stays off until a budget is configured in Settings
PAID_GENERATION_ENABLED=false
# ── platform connectors (Stage C) ──────────────────────────────────────────
# 64 hex chars (openssl rand -hex 32): seals platform tokens at rest. Without it, Connect buttons stay off.
INTEGRATIONS_KEY=
# the public https origin the platforms redirect back to (OAuth callbacks): https://studio.example.com
PUBLIC_ORIGIN=
# Google Cloud OAuth client (YouTube Data API v3 enabled; consent screen published to production for unattended uploads)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok for Developers app (Login Kit + Content Posting API; unaudited = inbox uploads / private direct posts)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta app with Instagram (Business Login for Instagram); the owner's professional account has a role on the app
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# ── push notifications (Stage E) ───────────────────────────────────────────
# who browser push services contact if notifications misbehave: mailto:you@example.com or your https site.
# Safari/iOS needs a real one; without it, PUBLIC_ORIGIN (when https) is used. The VAPID keys are made by the app
# itself on first use and sealed with INTEGRATIONS_KEY (or a key derived from SESSION_SECRET); never set them here.
PUSH_SUBJECT=
