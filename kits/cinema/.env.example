# Variable NAMES only. Never commit real values. None of these hold a secret except the optional paid ones.
# Needed to render
PLAYWRIGHT_DIR=            # folder that contains node_modules/playwright (run.sh derives it from `npm root -g`)
CHROMIUM=                  # path to a Chromium binary (default /opt/pw-browsers/chromium)
# Needed for narration
CINEMA_VOICE=              # where setup.sh built the voice venv and models (default ~/.cache/cinema-voice)
# Optional: voice clone (kits/cinema/voice/CLONE.md)
CLONE_MODEL_DIR=
VOICE_IN=
# Optional: pushing finished films to a hosted Prism Studio (not part of rendering)
STUDIO_URL=
MEDIA_PUSH_TOKEN=          # SECRET: keep it in your host's secret settings, never in this file
# Optional: paid image generation for new key art (off by default)
OPENAI_API_KEY=            # SECRET
GEMINI_API_KEY=            # SECRET
