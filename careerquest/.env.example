# ---- Required ----
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/careerquest?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
# APP_URL is the public origin users open the app on. It is also the OAuth redirect base
# ({APP_URL}/api/oauth/<provider>/callback — open the app on this exact origin or the OAuth state
# cookie is not found on callback), the base of the extension API's detailUrl links, and the only
# non-extension origin answered by CORS on /api/extension/*.
APP_URL="http://localhost:3000"

# ---- Optional integrations (leave blank to keep them in manual/demo mode) ----
# Google OAuth (Gmail read-only import). Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Entra app (Outlook Mail.Read). Create at https://entra.microsoft.com
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
# Anthropic API key for the optional AI coach provider (rules-based coach works without it)
ANTHROPIC_API_KEY=""
# Web push (VAPID) keys for notifications; generate with `npm run push:keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Shared secret for scheduler endpoints (POST /api/integrations/sync, POST /api/notifications/dispatch),
# sent as `Authorization: Bearer $CRON_SECRET`. Must be at least 16 characters; shorter values disable
# the scheduler path entirely.
CRON_SECRET=""
# Only set when running behind a trusted reverse proxy that appends X-Forwarded-For
TRUST_PROXY="false"
TRUST_PROXY_HOPS="1"
# Where uploaded documents (pay stubs, certificates, résumés) are stored; defaults to ./uploads
UPLOAD_DIR=""
