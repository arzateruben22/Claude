# Copy this file to .env and fill it in. .env never leaves your computer (it's in .gitignore).

# X developer app (developer.x.com → your app → Keys and tokens → OAuth 2.0 Client ID and Secret)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Claude API key (console.anthropic.com → API keys). Without it you write every draft yourself.
ANTHROPIC_API_KEY=
