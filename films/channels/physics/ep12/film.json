 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 3.429,
   "file": "vo/01.wav",
   "text": "How fast is rain? It starts far above, in clouds."
  },
  {
   "id": "vo02",
   "t": 4.133333333333334,
   "dur": 12.984,
   "file": "vo/02.wav",
   "text": "A stone dropped from a roof keeps speeding up until it lands. A raindrop doesn't. Watch the ghosts: the gaps grow, then stop growing. It reaches its top speed almost at once."
  },
  {
   "id": "vo03",
   "t": 17.966666666666665,
   "dur": 8.332,
   "file": "vo/03.wav",
   "text": "The air pushes back. You feel it with a hand out of a car window. The faster the drop falls, the harder the air pushes."
  },
  {
   "id": "vo04",
   "t": 27.133333333333333,
   "dur": 11.703,
   "file": "vo/04.wav",
   "text": "It's a tug of war between the weight pulling down and the air pushing up. At some speed, the push of the air matches the drop's weight. After that, the speed stays the same."
  },
  {
   "id": "vo05",
   "t": 39.86666666666667,
   "dur": 10.893,
   "file": "vo/05.wav",
   "text": "Big drops fall faster than small ones. Raindrops are never teardrops. Small ones are round, and the biggest flatten like a bun, and then break apart."
  },
  {
   "id": "vo06",
   "t": 51.666666666666664,
   "dur": 8.854,
   "file": "vo/06.wav",
   "text": "Measure it: in this model, a one-millimeter drop tops out near five meters a second. A four-millimeter drop, near nine."
  },
  {
   "id": "vo07",
   "t": 61.333333333333336,
   "dur": 5.503,
   "file": "vo/07.wav",
   "text": "The air gives every drop a speed limit. So rain from way up high lands gently."
  },
  {
   "id": "vo08",
   "t": 67.76666666666667,
   "dur": 3.887,
   "file": "vo/08.wav",
   "text": "That's season two. Thanks for watching, and see you next time."
  }
 ]
