 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 3.859,
   "file": "vo/01.wav",
   "text": "Which ball lands first? One thrown sideways, one just dropped."
  },
  {
   "id": "vo02",
   "t": 4.666666666666667,
   "dur": 9.032,
   "file": "vo/02.wav",
   "text": "Here's a drop, slowed twenty times. Ghosts every twentieth of a second, and the gaps keep growing: a falling ball speeds up the whole way down."
  },
  {
   "id": "vo03",
   "t": 14.233333333333333,
   "dur": 8.806,
   "file": "vo/03.wav",
   "text": "Now throw one sideways from the same height, at the same instant. It sails twenty centimeters across… and lands on the same frame."
  },
  {
   "id": "vo04",
   "t": 23.733333333333334,
   "dur": 13.451,
   "file": "vo/04.wav",
   "text": "Gravity pulls both balls down the same way. In sixteen thirty-eight, Galileo described a throw as two motions: a steady glide across, plus a fall. So at every tick, both sit at the same height."
  },
  {
   "id": "vo05",
   "t": 39.5,
   "dur": 9.751,
   "file": "vo/05.wav",
   "text": "Throw twice as hard, then three times: forty centimeters out, then sixty. Every row of ghosts stays level, and all four land on the same frame."
  },
  {
   "id": "vo06",
   "t": 52.46666666666667,
   "dur": 8.163,
   "file": "vo/06.wav",
   "text": "Measure it: nine gaps of a twentieth of a second. A one-meter fall takes about point four five seconds, thrown or dropped."
  },
  {
   "id": "vo07",
   "t": 61.36666666666667,
   "dur": 6.974,
   "file": "vo/07.wav",
   "text": "Sideways speed changes where a ball lands, not when. For a level throw, only the height sets the clock."
  },
  {
   "id": "vo08",
   "t": 69.1,
   "dur": 4.157,
   "file": "vo/08.wav",
   "text": "Next: why big swings and small swings take almost the same time."
  }
 ]
}