 "endCard": 73.4333,
 "end": {
  "title": "Next drop: the swing's *secret*",
  "follow": "Follow Rest Frame",
  "foot": "Two motions at once: Galileo, Two New Sciences, 1638"
 },
 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 3.715,
   "file": "vo/01.wav",
   "text": "Which ball lands first? One thrown sideways, one just dropped."
  },
  {
   "id": "vo02",
   "t": 4.333333333333333,
   "dur": 9.389,
   "file": "vo/02.wav",
   "text": "First, just the drop, slowed twenty times. Ghosts every twentieth of a second, and the gaps keep growing: a falling ball speeds up the whole way down."
  },
  {
   "id": "vo03",
   "t": 14.233333333333333,
   "dur": 7.917,
   "file": "vo/03.wav",
   "text": "Now throw one sideways: same height, same instant. It flies twenty centimeters farther… and still lands on the same frame."
  },
  {
   "id": "vo04",
   "t": 22.833333333333332,
   "dur": 13.814,
   "file": "vo/04.wav",
   "text": "Old gunnery books drew cannonballs flying straight, then dropping. Galileo saw two motions at once: a steady glide across, plus a fall. Gravity pulls only down, so at every tick, both sit at the same height."
  },
  {
   "id": "vo05",
   "t": 38.8,
   "dur": 9.397,
   "file": "vo/05.wav",
   "text": "Throw twice as fast, then three times: forty centimeters, then sixty. Every row of ghosts stays level, and all four land on the same frame."
  },
  {
   "id": "vo06",
   "t": 51.4,
   "dur": 8.374,
   "file": "vo/06.wav",
   "text": "Measure it: nine gaps, a twentieth of a second each. A one-meter fall takes about point four five seconds, thrown or dropped."
  },
  {
   "id": "vo07",
   "t": 60.53333333333333,
   "dur": 7.572,
   "file": "vo/07.wav",
   "text": "Sideways speed decides where it lands. Height alone decides when. In air, the throws land a sliver after the drop."
  },
  {
   "id": "vo08",
   "t": 68.83333333333333,
   "dur": 4.298,
   "file": "vo/08.wav",
   "text": "Next: one pendulum, big swing against small. It's almost a tie."
  }
 ]
}