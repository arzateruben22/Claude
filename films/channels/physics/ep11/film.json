 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 3.495,
   "file": "vo/01.wav",
   "text": "Can you hear a cup fill? Eyes closed, just listening."
  },
  {
   "id": "vo02",
   "t": 4.133333333333334,
   "dur": 8.881,
   "file": "vo/02.wav",
   "text": "Pour water into a cup, and the sound climbs higher and higher. A computer can even work out the water level from the sound alone."
  },
  {
   "id": "vo03",
   "t": 13.966666666666667,
   "dur": 7.974,
   "file": "vo/03.wav",
   "text": "The empty space above the water acts like a pipe, closed at the water end. Sound bounces up and down inside it."
  },
  {
   "id": "vo04",
   "t": 22.6,
   "dur": 12.88,
   "file": "vo/04.wav",
   "text": "A short pipe rings higher than a long one. A flute player changes the note by changing the length of the pipe. As the water rises, the empty space shrinks, and the pitch climbs."
  },
  {
   "id": "vo05",
   "t": 36.4,
   "dur": 8.398,
   "file": "vo/05.wav",
   "text": "Less empty space, a higher pitch. With two centimeters left, the cup rings nearly three times higher than when empty."
  },
  {
   "id": "vo06",
   "t": 45.8,
   "dur": 10.613,
   "file": "vo/06.wav",
   "text": "Measure it: with ten centimeters of empty space, you hear about seven hundred vibrations a second. With two centimeters, you hear nearly two thousand."
  },
  {
   "id": "vo07",
   "t": 57.333333333333336,
   "dur": 6.106,
   "file": "vo/07.wav",
   "text": "A shorter pipe makes a higher note. Next time you pour, listen: the cup tells you its level."
  },
  {
   "id": "vo08",
   "t": 64.3,
   "dur": 3.437,
   "file": "vo/08.wav",
   "text": "Next: a raindrop falls a mile. Why doesn't it hurt?"
  }
 ]
