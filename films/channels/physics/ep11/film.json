 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 3.57,
   "file": "vo/01.wav",
   "text": "Can you hear a mug fill? Eyes closed, just listening."
  },
  {
   "id": "vo02",
   "t": 4.4,
   "dur": 9.059,
   "file": "vo/02.wav",
   "text": "Pour water into a mug, and the sound climbs higher and higher. A computer can even work out the water level from the sound alone."
  },
  {
   "id": "vo03",
   "t": 14.5,
   "dur": 7.974,
   "file": "vo/03.wav",
   "text": "The empty space above the water acts like a pipe, closed at the water end. Sound bounces up and down inside it."
  },
  {
   "id": "vo04",
   "t": 23.133333333333333,
   "dur": 12.88,
   "file": "vo/04.wav",
   "text": "A short pipe rings higher than a long one. A flute player changes the note by changing the length of the pipe. As the water rises, the empty space shrinks, and the pitch climbs."
  },
  {
   "id": "vo05",
   "t": 36.93333333333333,
   "dur": 8.49,
   "file": "vo/05.wav",
   "text": "Less empty space, a higher pitch. With two centimeters left, the mug rings nearly three times higher than when empty."
  },
  {
   "id": "vo06",
   "t": 46.333333333333336,
   "dur": 10.613,
   "file": "vo/06.wav",
   "text": "Measure it: with ten centimeters of empty space, you hear about seven hundred vibrations a second. With two centimeters, you hear nearly two thousand."
  },
  {
   "id": "vo07",
   "t": 57.86666666666667,
   "dur": 6.757,
   "file": "vo/07.wav",
   "text": "A shorter pipe makes a higher note. Next time you pour, listen: the mug tells you how full it is."
  },
  {
   "id": "vo08",
   "t": 65.36666666666666,
   "dur": 3.437,
   "file": "vo/08.wav",
   "text": "Next: a raindrop falls a mile. Why doesn't it hurt?"
  }
 ]
