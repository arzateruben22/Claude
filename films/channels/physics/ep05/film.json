 "endCard": 65.4333,
 "end": {
  "title": "Next drop: the ten-meter *straw*",
  "follow": "Follow Rest Frame",
  "foot": "Olivia Oliver, 342 rpm, Warsaw 2015: the Guinness record for the fastest spin on ice skates (as of 2026)."
 },
 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 3.258,
   "file": "vo/01.wav",
   "text": "Why does it speed up? Nobody pushes. Nothing motorized."
  },
  {
   "id": "vo02",
   "t": 4.166666666666667,
   "dur": 8.038,
   "file": "vo/02.wav",
   "text": "Sit on a swivel chair with two dumbbells, arms out wide. Give yourself one gentle push. You turn about once every two seconds."
  },
  {
   "id": "vo03",
   "t": 12.9,
   "dur": 5.718,
   "file": "vo/03.wav",
   "text": "Now pull both dumbbells in, to your chest. Suddenly, you're whipping round more than twice as fast."
  },
  {
   "id": "vo04",
   "t": 19.466666666666665,
   "dur": 14.881,
   "file": "vo/04.wav",
   "text": "It feels like something pushed. Nothing outside did. With no twist from outside, your total amount of spin can't change. Weight near the middle is easier to turn, so the same amount turns you faster. Your arms paid for every extra turn."
  },
  {
   "id": "vo05",
   "t": 36.833333333333336,
   "dur": 8.839,
   "file": "vo/05.wav",
   "text": "Skaters use this. The record, set by a young Canadian skater: three hundred forty-two turns a minute. Nearly six turns a second."
  },
  {
   "id": "vo06",
   "t": 49.0,
   "dur": 6.206,
   "file": "vo/06.wav",
   "text": "Measure it: ghosts a tenth of a second apart. Arms out, eighteen degrees. Arms in, nearly fifty."
  },
  {
   "id": "vo07",
   "t": 56.03333333333333,
   "dur": 4.015,
   "file": "vo/07.wav",
   "text": "One push set your total spin. Your arms just decide how fast."
  },
  {
   "id": "vo08",
   "t": 60.833333333333336,
   "dur": 4.391,
   "file": "vo/08.wav",
   "text": "Next: a drinking straw, three stories tall. Could you still drink through it?"
  }
 ]
}