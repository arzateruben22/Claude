 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 3.1,
   "file": "vo/01.wav",
   "text": "Why does coffee leave a ring? Not… blobs."
  },
  {
   "id": "vo02",
   "t": 3.8666666666666667,
   "dur": 10.008,
   "file": "vo/02.wav",
   "text": "Spill a drop of coffee and let it dry. It leaves a dark ring, with a paler middle. Coffee is mostly water, with tiny brown specks in it."
  },
  {
   "id": "vo03",
   "t": 14.766666666666667,
   "dur": 4.822,
   "file": "vo/03.wav",
   "text": "Watch the specks. They don't stay put. They stream outward, toward the edge."
  },
  {
   "id": "vo04",
   "t": 20.2,
   "dur": 11.126,
   "file": "vo/04.wav",
   "text": "The edge of the drop is stuck to the paper. Water evaporates from that edge, so water from the middle flows out to replace it. The flow carries the specks along."
  },
  {
   "id": "vo05",
   "t": 32.4,
   "dur": 9.745,
   "file": "vo/05.wav",
   "text": "As the drop thins, the flow speeds up. In the last moments, the specks pile up at the edge. Make the specks oval, and the ring can vanish."
  },
  {
   "id": "vo06",
   "t": 43.13333333333333,
   "dur": 4.13,
   "file": "vo/06.wav",
   "text": "Measure it: in this model, nine in ten specks reach the ring."
  },
  {
   "id": "vo07",
   "t": 48.0,
   "dur": 9.246,
   "file": "vo/07.wav",
   "text": "Oval specks cling together at the surface, which can hold them back from the edge. A stuck edge and an outward flow: that's all a ring takes."
