 "endCard": 70.5,
 "end": {
  "title": "Next drop: the nut that *rises*",
  "follow": "Follow Reality Rulebook",
  "foot": "Twist first, then bend: usually two pieces. Heisser et al., PNAS 115, 8665 (2018)."
 },
 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 3.475,
   "file": "vo/01.wav",
   "text": "How many pieces? Bend a spaghetti stick until it snaps."
  },
  {
   "id": "vo02",
   "t": 4.133333333333334,
   "dur": 9.121,
   "file": "vo/02.wav",
   "text": "Hold both ends and push them together, slowly. The stick curves, then snaps. You expect two halves. You almost always get three or more."
  },
  {
   "id": "vo03",
   "t": 13.966666666666667,
   "dur": 5.8,
   "file": "vo/03.wav",
   "text": "Slowed down, the first break isn't the end. A moment later, it snaps again, and again."
  },
  {
   "id": "vo04",
   "t": 20.466666666666665,
   "dur": 14.375,
   "file": "vo/04.wav",
   "text": "The physicist Richard Feynman noticed this, and asked why. Years later, two physicists explained it. The first break sends ripples along the stick. They bend it even more than before, and that extra bend breaks it again."
  },
  {
   "id": "vo05",
   "t": 37.2,
   "dur": 10.023,
   "file": "vo/05.wav",
   "text": "In twenty eighteen, a team at MIT found a trick. Twist the stick first, over two thirds of a turn. Then bend it: usually just two pieces."
  },
  {
   "id": "vo06",
   "t": 50.6,
   "dur": 6.792,
   "file": "vo/06.wav",
   "text": "Measure it: little twist, three or more pieces. Past about two hundred fifty degrees, two pieces win."
  },
  {
   "id": "vo07",
   "t": 58.13333333333333,
   "dur": 7.236,
   "file": "vo/07.wav",
   "text": "It depends on how you break it. Bend slowly: a chain of snaps. Twist first: usually one clean break."
  },
  {
   "id": "vo08",
   "t": 66.16666666666667,
   "dur": 3.991,
   "file": "vo/08.wav",
   "text": "Next: a jar of nuts. The biggest one tends to climb."
  }
 ]
}