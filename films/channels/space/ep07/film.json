 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 2.61,
   "file": "vo/01.wav",
   "text": "More trees, or more stars? Guess first."
  },
  {
   "id": "vo02",
   "t": 3.5,
   "dur": 9.421,
   "file": "vo/02.wav",
   "text": "Our galaxy has hundreds of billions of stars. Nobody counted them. Most of its weight is dark matter, not stars, so the number is an estimate."
  },
  {
   "id": "vo03",
   "t": 13.633333333333333,
   "dur": 8.497,
   "file": "vo/03.wav",
   "text": "Now the trees. In twenty fifteen, a team put Earth's at about three trillion. That's several hundred trees for every person alive."
  },
  {
   "id": "vo04",
   "t": 22.7,
   "dur": 12.091,
   "file": "vo/04.wav",
   "text": "Researchers counted trees in ground plots, then scaled up with satellite maps. Both are estimates, not exact counts, so each really means about. The honest answer is a range."
  },
  {
   "id": "vo05",
   "t": 37.1,
   "dur": 8.862,
   "file": "vo/05.wav",
   "text": "Now turn every star into a tree. The stars run out, and Earth's forests keep going. Trees win, by roughly eight to thirty times."
  },
  {
   "id": "vo06",
   "t": 49.36666666666667,
   "dur": 6.377,
   "file": "vo/06.wav",
   "text": "So the next tree you pass is one of more than the stars. Big numbers hide in ordinary places."
  },
  {
   "id": "vo07",
   "t": 56.3,
   "dur": 7.805,
   "file": "vo/07.wav",
   "text": "Light time across our galaxy: longer than all of written history. Across a city block: about a millionth of a second."
  },
  {
   "id": "vo08",
   "t": 64.83333333333333,
   "dur": 3.661,
   "file": "vo/08.wav",
   "text": "Next: with that many stars, why is the night sky dark?"
  }
 ]
