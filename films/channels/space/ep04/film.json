 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 3.095,
   "file": "vo/01.wav",
   "text": "What's holding the Moon up? Nothing. It's falling."
  },
  {
   "id": "vo02",
   "t": 4.033333333333333,
   "dur": 9.438,
   "file": "vo/02.wav",
   "text": "Look up tonight: it's about thirty Earths away. And it moves sideways at about a kilometer every second. That's New York to Boston in five minutes."
  },
  {
   "id": "vo03",
   "t": 14.166666666666666,
   "dur": 8.907,
   "file": "vo/03.wav",
   "text": "Now switch gravity off. The Moon would fly off in a straight line. Gravity bends it back toward us. Every moment, all the way round."
  },
  {
   "id": "vo04",
   "t": 24.3,
   "dur": 16.237,
   "file": "vo/04.wav",
   "text": "The heavens, people believed, had their own rules. Isaac Newton, the story goes, wondered if the pull that drops an apple reaches the Moon. The Moon is sixty times farther from Earth's center than the apple. So the pull there is thirty-six hundred times weaker."
  },
  {
   "id": "vo05",
   "t": 42.96666666666667,
   "dur": 7.81,
   "file": "vo/05.wav",
   "text": "Then in one minute, the Moon should fall as far as an apple falls in one second. About five meters. And it does."
  },
  {
   "id": "vo06",
   "t": 54.166666666666664,
   "dur": 5.749,
   "file": "vo/06.wav",
   "text": "So the pull that drops an apple is the very same pull that holds the Moon."
  },
  {
   "id": "vo07",
   "t": 60.56666666666667,
   "dur": 5.457,
   "file": "vo/07.wav",
   "text": "Light time, Earth to Moon: one point three seconds. You always see the Moon that late."
  },
  {
   "id": "vo08",
   "t": 66.96666666666667,
   "dur": 4.131,
   "file": "vo/08.wav",
   "text": "Next: pour Earths into the Sun. How many to fill it up?"
  }
 ]
