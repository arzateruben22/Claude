 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 3.09,
   "file": "vo/01.wav",
   "text": "Are the footprints still there? On the Moon."
  },
  {
   "id": "vo02",
   "t": 4.033333333333333,
   "dur": 10.574,
   "file": "vo/02.wav",
   "text": "In nineteen sixty-nine, Apollo astronauts walked in the Moon's dust. Since then, orbiters have photographed tracks left by later missions. The tracks are still there."
  },
  {
   "id": "vo03",
   "t": 15.233333333333333,
   "dur": 7.707,
   "file": "vo/03.wav",
   "text": "On Earth, wind and rain wipe a footprint out in days. The Moon has almost no air, so no wind and no rain."
  },
  {
   "id": "vo04",
   "t": 23.766666666666666,
   "dur": 12.059,
   "file": "vo/04.wav",
   "text": "Only slow things wear a print down. Tiny space grains keep hitting the dust, one at a time. That sandblasting wears the Moon down about a millimeter every million years."
  },
  {
   "id": "vo05",
   "t": 38.166666666666664,
   "dur": 8.783,
   "file": "vo/05.wav",
   "text": "Pull back from one boot print to the whole site. The lander's base and the tracks are still where the astronauts left them, as orbiters show."
  },
  {
   "id": "vo06",
   "t": 50.43333333333333,
   "dur": 6.623,
   "file": "vo/06.wav",
   "text": "No beach on Earth keeps a footprint like that. Look up tonight: some of them may still be there."
  },
  {
   "id": "vo07",
   "t": 57.9,
   "dur": 6.633,
   "file": "vo/07.wav",
   "text": "Light time to the Moon: about one and a quarter seconds. Close enough to talk, with a short wait."
  },
  {
   "id": "vo08",
   "t": 65.36666666666666,
   "dur": 4.374,
   "file": "vo/08.wav",
   "text": "That's season two. Next: another orbit, another question, same sky."
  }
 ]
