 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 2.836,
   "file": "vo/01.wav",
   "text": "Why is the night sky dark? Look closely."
  },
  {
   "id": "vo02",
   "t": 3.5,
   "dur": 9.161,
   "file": "vo/02.wav",
   "text": "Say the universe has no edge or start. Then every line of sight would end on a star. Like a forest: every look hits a trunk."
  },
  {
   "id": "vo03",
   "t": 13.633333333333333,
   "dur": 8.406,
   "file": "vo/03.wav",
   "text": "Far stars look fainter, but there are more of them. Those two effects cancel, so the whole sky should glow like a star's surface."
  },
  {
   "id": "vo04",
   "t": 22.7,
   "dur": 9.719,
   "file": "vo/04.wav",
   "text": "The key here is time. Far starlight may not have had time to reach us yet. We now put the universe's age near thirteen point eight billion years."
  },
  {
   "id": "vo05",
   "t": 34.96666666666667,
   "dur": 9.22,
   "file": "vo/05.wav",
   "text": "Past a certain distance, starlight is still on its way. So we can only see so far. The dark sky hints that the universe has a beginning."
  },
  {
   "id": "vo06",
   "t": 47.766666666666666,
   "dur": 5.87,
   "file": "vo/06.wav",
   "text": "So tonight's dark isn't empty. It's a clue: the universe has not been shining forever."
  },
  {
   "id": "vo07",
   "t": 54.166666666666664,
   "dur": 6.295,
   "file": "vo/07.wav",
   "text": "Light time: from the Sun, about eight minutes. From the farthest galaxies we see, billions of years."
  },
  {
   "id": "vo08",
   "t": 61.1,
   "dur": 3.624,
   "file": "vo/08.wav",
   "text": "Next: where did the gold in your ring come from?"
  }
 ]
