 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 2.764,
   "file": "vo/01.wav",
   "text": "What's at a black hole's edge? Look closer."
  },
  {
   "id": "vo02",
   "t": 3.5,
   "dur": 10.187,
   "file": "vo/02.wav",
   "text": "The edge is called the event horizon. Escape speed is the speed needed to leave for good. Past that edge, escaping would take more than light speed."
  },
  {
   "id": "vo03",
   "t": 14.7,
   "dur": 8.867,
   "file": "vo/03.wav",
   "text": "Nothing travels faster than light, so nothing gets out from there. Now picture a friend, hovering close to it, while you watch from far away."
  },
  {
   "id": "vo04",
   "t": 24.3,
   "dur": 13.168,
   "file": "vo/04.wav",
   "text": "Gravity really does slow clocks. GPS satellites must correct for relativity to keep good time. The closer to a black hole, the slower a clock ticks. Now compare the two views."
  },
  {
   "id": "vo05",
   "t": 40.3,
   "dur": 10.56,
   "file": "vo/05.wav",
   "text": "To you, far away, your friend's clock seems to tick slower. To someone hovering close, everyone else seems to speed up. The closer they hover, the bigger the gap."
  },
  {
   "id": "vo06",
   "t": 54.166666666666664,
   "dur": 5.393,
   "file": "vo/06.wav",
   "text": "Both views are true. Time depends on where you are, and how strong gravity is."
  },
  {
   "id": "vo07",
   "t": 60.56666666666667,
   "dur": 7.808,
   "file": "vo/07.wav",
   "text": "Light time: we photographed a black hole in twenty nineteen. Its light had traveled about fifty-five million years."
  },
  {
   "id": "vo08",
   "t": 69.1,
   "dur": 2.703,
   "file": "vo/08.wav",
   "text": "Next: a planet lighter than water."
  }
 ]
