 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 3.379,
   "file": "vo/01.wav",
   "text": "How long to the nearest star? Say we leave today."
  },
  {
   "id": "vo02",
   "t": 4.033333333333333,
   "dur": 10.897,
   "file": "vo/02.wav",
   "text": "Our ride is Voyager 1, the farthest thing we've sent. It left in nineteen seventy-seven. It coasts at about seventeen kilometers a second. Earth to the Moon in six hours."
  },
  {
   "id": "vo03",
   "t": 15.766666666666667,
   "dur": 10.292,
   "file": "vo/03.wav",
   "text": "On November eighteenth, it crosses a line. Its signal now needs a full day to reach us. The team sends a command today. The answer comes the day after tomorrow."
  },
  {
   "id": "vo04",
   "t": 26.966666666666665,
   "dur": 11.922,
   "file": "vo/04.wav",
   "text": "In twenty twelve, it crossed into interstellar space. Nearly there, then? It hasn't even reached the Sun's cloud of comets. That's about three hundred years away. Through it: maybe thirty thousand more."
  },
  {
   "id": "vo05",
   "t": 41.36666666666667,
   "dur": 11.553,
   "file": "vo/05.wav",
   "text": "The nearest star, Proxima Centauri, is about fifteen hundred light-days out. At Voyager's speed: about seventy-five thousand years. Count back that far, and our species wasn't in Europe."
  },
  {
   "id": "vo06",
   "t": 56.3,
   "dur": 5.228,
   "file": "vo/06.wav",
   "text": "So we've barely left for the stars. Voyager has crossed day one of fifteen hundred."
  },
  {
   "id": "vo07",
   "t": 62.166666666666664,
   "dur": 5.779,
   "file": "vo/07.wav",
   "text": "Light time, Earth to Voyager: one day. To Proxima Centauri: four years and three months."
  },
  {
   "id": "vo08",
   "t": 68.56666666666666,
   "dur": 4.115,
   "file": "vo/08.wav",
   "text": "Next: a world that turns slower than it orbits. And backwards."
  }
 ]
}