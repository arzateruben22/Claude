 ],
 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 2.34,
   "file": "vo/01.wav",
   "text": "Where does gold come from? Look up."
  },
  {
   "id": "vo02",
   "t": 2.966666666666667,
   "dur": 9.816,
   "file": "vo/02.wav",
   "text": "Gold is heavier than iron. Atoms that heavy are built by soaking up neutrons. One way is the fast way: a place packed with neutrons."
  },
  {
   "id": "vo03",
   "t": 13.633333333333333,
   "dur": 10.137,
   "file": "vo/03.wav",
   "text": "One place that does that: two neutron stars crashing together. In twenty seventeen, astronomers saw one happen, as ripples in space and as light."
  },
  {
   "id": "vo04",
   "t": 24.3,
   "dur": 13.022,
   "file": "vo/04.wav",
   "text": "A neutron star is about as wide as a city, yet heavier than the Sun. A crash throws out hot matter, and some becomes heavy atoms. Scientists still debate what else makes heavy atoms."
  },
  {
   "id": "vo05",
   "t": 39.766666666666666,
   "dur": 9.305,
   "file": "vo/05.wav",
   "text": "Zoom in on your ring. Some of its gold may have been made in a crash like that, somewhere in space. Think of it as a souvenir."
  },
  {
   "id": "vo06",
   "t": 52.56666666666667,
   "dur": 6.316,
   "file": "vo/06.wav",
   "text": "So some gold may be leftovers of a star crash. Stardust isn't a poem. It's chemistry."
  },
  {
   "id": "vo07",
   "t": 59.5,
   "dur": 7.201,
   "file": "vo/07.wav",
   "text": "Light time: the crash's ripples in space came first. Its visible light was spotted several hours later."
  },
  {
   "id": "vo08",
   "t": 67.5,
   "dur": 3.844,
   "file": "vo/08.wav",
   "text": "Next: what happens at the edge of a black hole?"
  }
 ]
}