 "captions": [
  {
   "t0": 0.245,
   "t1": 2.64,
   "text": "Imagine the Moon never stopped coming.",
   "line": "ch1_hook"
  },
  {
   "t0": 2.767,
   "t1": 6.267,
   "text": "The sea is calm, and the Moon hangs over the water.",
   "line": "ch1_vo"
  },
  {
   "t0": 6.287,
   "t1": 8.857,
   "text": "Right now, it is drifting away from you.",
   "line": "ch1_vo"
  },
  {
   "t0": 8.877,
   "t1": 11.767,
   "text": "About three point eight centimeters a year.",
   "line": "ch1_vo"
  },
  {
   "t0": 11.787,
   "t1": 14.272,
   "text": "Tonight, imagine it reverses.",
   "line": "ch1_vo"
  },
  {
   "t0": 14.292,
   "t1": 17.107,
   "text": "It starts coming closer, and it never stops.",
   "line": "ch1_vo"
  },
  {
   "t0": 17.127,
   "t1": 19.182,
   "text": "Nothing here is a forecast.",
   "line": "ch1_vo"
  },
  {
   "t0": 19.202,
   "t1": 22.562,
   "text": "It is a thought experiment, built from real physics.",
   "line": "ch1_vo"
  },
  {
   "t0": 22.582,
   "t1": 24.977,
   "text": "First, where it really is.",
   "line": "ch1_vo"
  },
  {
   "t0": 24.997,
   "t1": 27.767,
   "text": "On average, the Moon is about three hundred",
   "line": "ch1_vo"
  },
  {
   "t0": 27.787,
   "t1": 30.187,
   "text": "eighty-four thousand kilometers away.",
   "line": "ch1_vo"
  },
  {
   "t0": 30.207,
   "t1": 33.227,
   "text": "From the beach, it looks about half a degree wide.",
   "line": "ch1_vo"
  },
  {
   "t0": 33.247,
   "t1": 35.642,
   "text": "About the same size as the Sun.",
   "line": "ch1_vo"
  },
  {
   "t0": 35.662,
   "t1": 38.962,
   "text": "Its light takes about a second and a quarter to reach you.",
   "line": "ch1_vo"
  },
  {
   "t0": 38.982,
   "t1": 42.722,
   "text": "Moonlight is just sunlight, bounced off grey rock.",
   "line": "ch1_vo"
  },
  {
   "t0": 42.742,
   "t1": 45.982,
   "text": "Same sea, same sand, same Moon.",
   "line": "ch1_vo"
  },
  {
   "t0": 46.002,
   "t1": 48.277,
   "text": "Only one thing will change.",
   "line": "ch1_vo"
  },
  {
   "t0": 48.41,
   "t1": 50.566,
   "text": "Quick thing: if that made the sky",
   "line": "cta1_subscribe"
  },
  {
   "t0": 50.586,
   "t1": 52.96,
   "text": "feel bigger, tap like and subscribe.",
   "line": "cta1_subscribe"
  },
  {
   "t0": 53.14,
   "t1": 55.71,
   "text": "Keep an eye on the number in the corner.",
   "line": "ch1_vo"
  },
  {
   "t0": 55.73,
   "t1": 57.505,
   "text": "It only ever goes down.",
   "line": "ch1_vo"
  },
  {
   "t0": 57.78,
   "t1": 61.54,
   "text": "And the first thing that changes is not what you'd expect.",
   "line": "ch1_loop"
  },
  {
   "t0": 61.686,
   "t1": 62.911,
   "text": "Part one of eight.",
   "line": "closer1"
  },
  {
   "t0": 62.931,
   "t1": 64.716,
   "text": "Full video on YouTube.",
   "line": "closer1"
  }
