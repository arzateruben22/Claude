   "spoken": "It's coming closer."
  },
  {
   "t0": 6.535,
   "t1": 9.53,
   "text": "Tonight, the Moon starts coming closer.",
   "line": "L1",
   "spoken": "Tonight, the Moon starts coming closer."
  },
  {
   "t0": 9.635,
   "t1": 11.93,
   "text": "And it never stops.",
   "line": "L1",
   "spoken": "And it never stops."
  },
  {
   "t0": 12.73,
   "t1": 20.535,
   "text": "Right now it's about 384,000 km away, drifting off 3.8 cm a year.",
   "line": "L2",
   "spoken": "Right now it's about three hundred eighty-four thousand kilometers away, drifting off three point eight centimeters a year."
  },
  {
   "t0": 20.555,
   "t1": 22.46,
   "text": "Tonight, it reverses.",
   "line": "L2",
   "spoken": "Tonight, it reverses."
  },
  {
   "t0": 22.57,
   "t1": 25.66,
   "text": "A thought experiment, built from real physics.",
   "line": "L2",
   "spoken": "A thought experiment, built from real physics."
  },
  {
   "t0": 26.28,
   "t1": 27.5,
   "text": "Watch the number.",
   "line": "L3",
   "spoken": "Watch the number."
  },
  {
   "t0": 27.52,
   "t1": 29.53,
   "text": "It only goes down.",
   "line": "L3",
   "spoken": "It only goes down."
  },
  {
   "t0": 36.04,
   "t1": 38.275,
   "text": "288,000.",
   "line": "L4",
   "spoken": "Two hundred eighty-eight thousand."
  },
  {
   "t0": 38.295,
   "t1": 40.5,
   "text": "A third wider.",
   "line": "L4",
   "spoken": "A third wider."
  },
  {
   "t0": 43.64,
   "t1": 47.1,
   "text": "And the sea already feels it: more than twice the tidal pull.",
   "line": "L4",
   "spoken": "And the sea already feels it: more than twice the tidal pull."
  },
  {
   "t0": 51.45,
   "t1": 54.15,
   "text": "If that made the sky feel bigger, tap like and follow.",
