  {
   "t0": 0.35,
   "t1": 1.16,
   "text": "Watch the Moon.",
   "line": "B1",
   "spoken": "Watch the Moon."
  },
  {
   "t0": 1.18,
   "t1": 2.8,
   "text": "It's coming closer.",
