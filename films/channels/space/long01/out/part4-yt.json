 "captions": [
  {
   "t0": 0.17,
   "t1": 2.24,
   "text": "The night is getting too bright.",
   "line": "ch4_hook"
  },
  {
   "t0": 2.386,
   "t1": 5.181,
   "text": "One hundred fifty thousand kilometers.",
   "line": "ch4_vo"
  },
  {
   "t0": 5.201,
   "t1": 7.916,
   "text": "The Moon looks about two and a half times wider.",
   "line": "ch4_vo"
  },
  {
   "t0": 7.936,
   "t1": 9.216,
   "text": "Look around you.",
   "line": "ch4_vo"
  },
  {
   "t0": 9.236,
   "t1": 10.871,
   "text": "The beach is brighter.",
   "line": "ch4_vo"
  },
  {
   "t0": 10.891,
   "t1": 13.042,
   "text": "Moonlight falls off with the square",
   "line": "ch4_vo"
  },
  {
   "t0": 13.062,
   "t1": 15.296,
   "text": "of the distance, for the same phase.",
   "line": "ch4_vo"
  },
  {
   "t0": 15.316,
   "t1": 17.804,
   "text": "So at this distance, a full Moon gives",
   "line": "ch4_vo"
  },
  {
   "t0": 17.824,
   "t1": 20.266,
   "text": "about six and a half times the light.",
   "line": "ch4_vo"
  },
  {
   "t0": 20.286,
   "t1": 23.006,
   "text": "Your shadow on the sand is sharp.",
   "line": "ch4_vo"
  },
  {
   "t0": 23.026,
   "t1": 25.636,
   "text": "The wet sand shines like a mirror.",
   "line": "ch4_vo"
  },
  {
   "t0": 25.656,
   "t1": 27.581,
   "text": "Even the headland is lit.",
   "line": "ch4_vo"
  },
  {
   "t0": 27.601,
   "t1": 30.401,
   "text": "And the Moon is crossing the sky faster.",
   "line": "ch4_vo"
  },
  {
   "t0": 30.421,
   "t1": 33.101,
   "text": "Closer orbits are faster orbits.",
   "line": "ch4_vo"
  },
  {
   "t0": 33.121,
   "t1": 38.051,
   "text": "At this distance, one lap takes about seven days, not twenty-seven.",
   "line": "ch4_vo"
  },
  {
   "t0": 38.071,
   "t1": 43.356,
   "text": "The water has a silver road across it, wider than any you have seen.",
   "line": "ch4_vo"
  },
  {
   "t0": 43.376,
   "t1": 45.935,
   "text": "Night is not as dark as it used to be,",
   "line": "ch4_vo"
  },
  {
   "t0": 45.955,
   "t1": 49.416,
   "text": "and it is about to get a different kind of strange.",
   "line": "ch4_vo"
  },
  {
   "t0": 49.604,
   "t1": 53.119,
   "text": "If you want one more orbit, tap like and subscribe.",
   "line": "cta4_subscribe"
  },
  {
   "t0": 53.233,
   "t1": 56.278,
   "text": "By now, the Moon looks far bigger than the Sun.",
   "line": "ch4_vo"
  },
  {
   "t0": 56.472,
   "t1": 58.873,
   "text": "Which means the next time they line up,",
   "line": "ch4_loop"
  },
  {
   "t0": 58.893,
   "t1": 60.942,
   "text": "something happens in the daytime.",
   "line": "ch4_loop"
  },
  {
   "t0": 61.132,
   "t1": 62.387,
   "text": "Part four of eight.",
   "line": "closer4"
  },
  {
   "t0": 62.407,
   "t1": 64.162,
   "text": "Full video on YouTube.",
