 "captions": [
  {
   "t0": 0.17,
   "t1": 2.5,
   "text": "It rises in the west",
   "line": "ch7_hook"
  },
  {
   "t0": 2.847,
   "t1": 4.997,
   "text": "Fifty thousand kilometers.",
   "line": "ch7_vo"
  },
  {
   "t0": 5.017,
   "t1": 8.442,
   "text": "The Moon is nearly eight times wider than tonight.",
   "line": "ch7_vo"
  },
  {
   "t0": 8.462,
   "t1": 12.202,
   "text": "The pull is about four hundred fifty times today's.",
   "line": "ch7_vo"
  },
  {
   "t0": 12.222,
   "t1": 15.207,
   "text": "One lap now takes about a day and a quarter.",
   "line": "ch7_vo"
  },
  {
   "t0": 15.227,
   "t1": 18.237,
   "text": "That is close to how fast the Earth turns.",
   "line": "ch7_vo"
  },
  {
   "t0": 18.257,
   "t1": 21.279,
   "text": "A moon that orbits slower than the Earth",
   "line": "ch7_vo"
  },
  {
   "t0": 21.299,
   "t1": 24.037,
   "text": "turns rises in the east, like today.",
   "line": "ch7_vo"
  },
  {
   "t0": 24.057,
   "t1": 28.467,
   "text": "A moon that orbits faster than the Earth turns rises in the west.",
   "line": "ch7_vo"
  },
  {
   "t0": 28.487,
   "t1": 32.627,
   "text": "The line between them is about forty-two thousand kilometers.",
   "line": "ch7_vo"
  },
  {
   "t0": 32.647,
   "t1": 36.142,
   "text": "In this picture its orbit is right over the equator.",
   "line": "ch7_vo"
  },
  {
   "t0": 36.162,
   "t1": 37.337,
   "text": "Watch the number.",
   "line": "ch7_vo"
  },
  {
   "t0": 37.357,
   "t1": 39.117,
   "text": "Forty-two thousand.",
   "line": "ch7_vo"
  },
  {
   "t0": 39.137,
   "t1": 42.432,
   "text": "The Moon hangs in your sky, almost still.",
   "line": "ch7_vo"
  },
  {
   "t0": 42.452,
   "t1": 45.847,
   "text": "Then it begins to slide the wrong way across it.",
   "line": "ch7_vo"
  },
  {
   "t0": 45.867,
   "t1": 48.347,
   "text": "The Moon rises in the west.",
   "line": "ch7_vo"
  },
  {
   "t0": 48.482,
   "t1": 50.387,
   "text": "Real quick: like and follow,",
   "line": "cta3_follow"
  },
  {
   "t0": 50.407,
   "t1": 53.432,
   "text": "if space just got a little stranger for you.",
   "line": "cta3_follow"
  },
  {
   "t0": 53.585,
   "t1": 55.305,
   "text": "But the number keeps falling.",
   "line": "ch7_vo"
  },
  {
   "t0": 55.531,
   "t1": 59.391,
   "text": "And there is a line ahead that nothing can hold together past.",
   "line": "ch7_loop"
  },
  {
