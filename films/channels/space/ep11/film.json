 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 3.14,
   "file": "vo/01.wav",
   "text": "Could the planet Saturn float? On paper, yes."
  },
  {
   "id": "vo02",
   "t": 4.033333333333333,
   "dur": 8.647,
   "file": "vo/02.wav",
   "text": "Saturn weighs less than the same amount of water, space for space. Here's a thought experiment: a tank of water wider than Saturn."
  },
  {
   "id": "vo03",
   "t": 13.633333333333333,
   "dur": 9.596,
   "file": "vo/03.wav",
   "text": "Saturn is about nine Earths wide. But it's mostly hydrogen and helium, the two lightest gases. Picture a giant ball of cloud."
  },
  {
   "id": "vo04",
   "t": 23.766666666666666,
   "dur": 10.916,
   "file": "vo/04.wav",
   "text": "Density means how much stuff is packed into a space. Earth is rock and metal, packed tight, so it sinks. Saturn is mostly gas, so its weight is spread thin."
  },
  {
   "id": "vo05",
   "t": 37.1,
   "dur": 8.33,
   "file": "vo/05.wav",
   "text": "In the thought experiment, Saturn floats. But real Saturn is gas, and it would mix with water. It would never stay in one piece."
  },
  {
   "id": "vo06",
   "t": 48.833333333333336,
   "dur": 5.579,
   "file": "vo/06.wav",
   "text": "Size alone doesn't tell you what's inside. Density tells you who floats and who sinks."
  },
  {
   "id": "vo07",
   "t": 55.233333333333334,
   "dur": 7.085,
   "file": "vo/07.wav",
   "text": "Light time: sunlight takes about eighty minutes to reach Saturn. That's a long way for the fastest thing there is."
  },
  {
   "id": "vo08",
   "t": 63.233333333333334,
   "dur": 4.216,
   "file": "vo/08.wav",
   "text": "Next: do the Apollo footprints still last on the Moon?"
  }
 ]
