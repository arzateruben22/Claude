 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 3.392,
   "file": "vo/01.wav",
   "text": "What if the Sun vanished? How soon would you know?"
  },
  {
   "id": "vo02",
   "t": 4.033333333333333,
   "dur": 9.424,
   "file": "vo/02.wav",
   "text": "Rewind. We circle the Sun at nearly thirty kilometers a second. It's so far away that even its light needs eight minutes and twenty seconds to reach us."
  },
  {
   "id": "vo03",
   "t": 14.166666666666666,
   "dur": 9.176,
   "file": "vo/03.wav",
   "text": "Now switch it off. Down here, nothing changes. Its last light is on the way: for over eight minutes, your sky looks exactly the same."
  },
  {
   "id": "vo04",
   "t": 24.3,
   "dur": 15.628,
   "file": "vo/04.wav",
   "text": "Gravity is no faster: changes in it travel at the speed of light. In twenty seventeen, we caught two neutron stars colliding. Their light and gravitational waves crossed a hundred and thirty million light-years, and arrived under two seconds apart."
  },
  {
   "id": "vo05",
   "t": 42.43333333333333,
   "dur": 8.349,
   "file": "vo/05.wav",
   "text": "So for eight minutes, Earth keeps circling a Sun that isn't there. Then the news arrives, and Earth sails off, straight into the dark."
  },
  {
   "id": "vo06",
   "t": 54.166666666666664,
   "dur": 5.366,
   "file": "vo/06.wav",
   "text": "Light and gravity share one speed limit. Everything you see in the sky is old news."
  },
  {
   "id": "vo07",
   "t": 60.03333333333333,
   "dur": 6.802,
   "file": "vo/07.wav",
   "text": "Light time, Sun to Earth: eight minutes, twenty seconds. Our galaxy's center: light from the last Ice Age."
  },
  {
   "id": "vo08",
   "t": 68.03333333333333,
   "dur": 3.684,
   "file": "vo/08.wav",
   "text": "Next: leave for the nearest star today. When do we arrive?"
  }
 ]
}