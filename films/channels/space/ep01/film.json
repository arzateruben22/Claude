 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 3.392,
   "file": "vo/01.wav",
   "text": "What if the Sun vanished? How soon would you know?"
  },
  {
   "id": "vo02",
   "t": 4.033333333333333,
   "dur": 11.698,
   "file": "vo/02.wav",
   "text": "Rewind. Earth circles the Sun about a hundred and fifty million kilometers out, at nearly thirty kilometers a second. Sunlight crosses that gap in eight minutes and twenty seconds."
  },
  {
   "id": "vo03",
   "t": 16.3,
   "dur": 8.137,
   "file": "vo/03.wav",
   "text": "Now switch the Sun off. Its last light is still on the way, so for over eight minutes, your sky looks exactly the same."
  },
  {
   "id": "vo04",
   "t": 25.366666666666667,
   "dur": 15.203,
   "file": "vo/04.wav",
   "text": "Gravity is no faster: changes in it travel at the speed of light. In twenty seventeen, gravitational waves and light from colliding neutron stars crossed a hundred and thirty million light-years, and arrived less than two seconds apart."
  },
  {
   "id": "vo05",
   "t": 42.96666666666667,
   "dur": 8.139,
   "file": "vo/05.wav",
   "text": "So for eight minutes, Earth keeps circling a Sun that isn't there. Then the news arrives, and Earth sails off in a straight line."
  },
  {
   "id": "vo06",
   "t": 54.7,
   "dur": 5.366,
   "file": "vo/06.wav",
   "text": "Light and gravity share one speed limit. Everything you see in the sky is old news."
  },
  {
   "id": "vo07",
   "t": 60.56666666666667,
   "dur": 7.288,
   "file": "vo/07.wav",
   "text": "Light time, Sun to Earth: eight minutes, twenty seconds. From the center of our galaxy: twenty-seven thousand years."
  },
  {
   "id": "vo08",
   "t": 68.56666666666666,
   "dur": 4.29,
   "file": "vo/08.wav",
   "text": "Next: how long would it take us to reach the nearest star?"
  }
 ]
}