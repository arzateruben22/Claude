 "voice": [
  {
   "id": "vo01",
   "t": 0.06666666666666667,
   "dur": 5.065,
   "file": "vo/01.wav",
   "text": "Poison, in a frown? In theory, a banknote's weight could kill a million."
  },
  {
   "id": "vo02",
   "t": 5.9,
   "dur": 9.823,
   "file": "vo/02.wav",
   "text": "Every frown starts at a nerve ending, letting out a chemical messenger onto the muscle below. The muscle pulls, and the skin above folds into a crease."
  },
  {
   "id": "vo03",
   "t": 16.633333333333333,
   "dur": 9.782,
   "file": "vo/03.wav",
   "text": "Botulinum toxin never touches the skin. It slips inside the nerve ending and cuts one protein the message needs, so the message waits, and never leaves."
  },
  {
   "id": "vo04",
   "t": 27.366666666666667,
   "dur": 9.973,
   "file": "vo/04.wav",
   "text": "Two centuries ago a German doctor, Justinus Kerner, traced a deadly paralysis to spoiled sausages, and guessed the same poison might one day become a medicine."
  },
  {
   "id": "vo05",
   "t": 39.96666666666667,
   "dur": 8.629,
   "file": "vo/05.wav",
   "text": "Its dose is counted in units, measured by their effect on mice. One frown takes twenty, under a hundredth of what could kill a person."
  },
  {
   "id": "vo06",
   "t": 52.1,
   "dur": 6.552,
   "file": "vo/06.wav",
   "text": "And the gap that message never crosses is about two thousand times thinner than a sheet of paper."
  },
  {
   "id": "vo07",
   "t": 59.56666666666667,
   "dur": 7.257,
   "file": "vo/07.wav",
   "text": "Poison in a frown: one message silenced, and months later the nerve grows spare endings, then prunes them away."
  },
  {
   "id": "vo08",
   "t": 67.96666666666667,
   "dur": 4.523,
   "file": "vo/08.wav",
   "text": "Next: two neighbours under the same sun, one experiment. Which hand aged?"
  }
 ]
