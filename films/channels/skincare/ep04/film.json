 "voice": [
  {
   "id": "vo01",
   "t": 0.06666666666666667,
   "dur": 4.727,
   "file": "vo/01.wav",
   "text": "Poison, in a frown? Among the most poisonous substances known, by the nanogram."
  },
  {
   "id": "vo02",
   "t": 5.9,
   "dur": 10.054,
   "file": "vo/02.wav",
   "text": "Every frown starts at a nerve ending, which lets out a chemical messenger onto the muscle below. The muscle pulls, and the skin above it folds into a crease."
  },
  {
   "id": "vo03",
   "t": 17.1,
   "dur": 10.528,
   "file": "vo/03.wav",
   "text": "Botulinum toxin never touches the skin. It slips inside the nerve ending and cuts one small protein the message needs, so the message is ready, and never leaves."
  },
  {
   "id": "vo04",
   "t": 28.766666666666666,
   "dur": 10.555,
   "file": "vo/04.wav",
   "text": "Two centuries ago, a German doctor named Justinus Kerner traced a deadly paralysis to spoiled sausages. And he guessed that the same poison might one day become a medicine."
  },
  {
   "id": "vo05",
   "t": 41.833333333333336,
   "dur": 7.294,
   "file": "vo/05.wav",
   "text": "So how much goes in? The whole frown takes well under a hundredth of the amount estimated to kill a person."
  },
  {
   "id": "vo06",
   "t": 53.03333333333333,
   "dur": 6.552,
   "file": "vo/06.wav",
   "text": "And the gap that message never crosses is about two thousand times thinner than a sheet of paper."
  },
  {
   "id": "vo07",
   "t": 60.5,
   "dur": 5.815,
   "file": "vo/07.wav",
   "text": "Poison in a frown: just enough to silence one message, until the nerve grows new endings."
  },
  {
   "id": "vo08",
   "t": 67.5,
   "dur": 4.523,
   "file": "vo/08.wav",
   "text": "Next: two neighbours under the same sun, one experiment. Which hand aged?"
  }
 ]
