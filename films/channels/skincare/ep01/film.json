 "voice": [
  {
   "id": "vo01",
   "t": 0.06666666666666667,
   "dur": 4.099,
   "file": "vo/01.wav",
   "text": "Is your skin alive? The part you see? Not one cell."
  },
  {
   "id": "vo02",
   "t": 4.966666666666667,
   "dur": 9.474,
   "file": "vo/02.wav",
   "text": "Your outermost layer is about fifteen rows of flattened cells. Each one is dead: a flat shell packed with keratin. The living skin starts just beneath them."
  },
  {
   "id": "vo03",
   "t": 15.233333333333333,
   "dur": 10.601,
   "file": "vo/03.wav",
   "text": "Follow one cell from the bottom. It's born alive, at the base. For about two weeks it rises, filling with keratin. Then, near the top, it takes itself apart, on purpose."
  },
  {
   "id": "vo04",
   "t": 26.9,
   "dur": 10.99,
   "file": "vo/04.wav",
   "text": "That layer looks like waste, waiting to flake off. Scientists picture it as a brick wall: dead cells for bricks, fats for mortar. And that wall is what keeps your water inside."
  },
  {
   "id": "vo05",
   "t": 40.43333333333333,
   "dur": 10.236,
   "file": "vo/05.wav",
   "text": "In nineteen seventy-nine, two doctors measured water leaving the skin of newborns. Babies born before thirty weeks, before that wall is finished, lost about five times as much."
  },
  {
   "id": "vo06",
   "t": 54.43333333333333,
   "dur": 7.113,
   "file": "vo/06.wav",
   "text": "To scale: on the cheek, the whole dead layer is about seventeen micrometers. A sheet of paper is about a hundred."
  },
  {
   "id": "vo07",
   "t": 62.36666666666667,
   "dur": 5.315,
   "file": "vo/07.wav",
   "text": "Every day, you're kept alive by cells that already died to build a wall."
  },
  {
   "id": "vo08",
   "t": 68.43333333333334,
   "dur": 3.844,
   "file": "vo/08.wav",
   "text": "Next: does SPF one hundred block twice as much as fifty?"
  }
 ]
