 "voice": [
  {
   "id": "vo01",
   "t": 0.06666666666666667,
   "dur": 4.901,
   "file": "vo/01.wav",
   "text": "Is this spot new? Its fight began under skin that looked perfectly clear."
  },
  {
   "id": "vo02",
   "t": 5.9,
   "dur": 9.116,
   "file": "vo/02.wav",
   "text": "Follow faces photo by photo, and more than one new red spot in four rises from skin that looked clear. So what was happening underneath?"
  },
  {
   "id": "vo03",
   "t": 16.166666666666668,
   "dur": 8.318,
   "file": "vo/03.wav",
   "text": "Beneath that clear skin, the defence has already gathered, immune cells crowding the follicle, some as thickly as in a red spot."
  },
  {
   "id": "vo04",
   "t": 25.5,
   "dur": 11.866,
   "file": "vo/04.wav",
   "text": "It's easy to picture an infection. But it's the most common bacterium in clear, oily skin, and skin with acne carries no more. What makes the spot is largely your body's answer."
  },
  {
   "id": "vo05",
   "t": 39.96666666666667,
   "dur": 9.302,
   "file": "vo/05.wav",
   "text": "White cells flood in until the follicle's wall can give way, spilling the fight deeper. Each day, your marrow makes several for every person on Earth."
  },
  {
   "id": "vo06",
   "t": 53.03333333333333,
   "dur": 7.85,
   "file": "vo/06.wav",
   "text": "And pus is the fight's fallen: white cells so small that ten in a row still wouldn't span this paper's thickness."
  },
  {
   "id": "vo07",
   "t": 61.9,
   "dur": 7.399,
   "file": "vo/07.wav",
   "text": "Is it new? No: a fight begun out of sight, against a germ that even helps build your skin's barrier."
  },
  {
   "id": "vo08",
   "t": 70.3,
   "dur": 4.047,
   "file": "vo/08.wav",
   "text": "Next: the light on your face, and where it really goes."
  }
 ]
