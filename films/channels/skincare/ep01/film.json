 "voice": [
  {
   "id": "vo01",
   "t": 0.06666666666666667,
   "dur": 4.668,
   "file": "vo/01.wav",
   "text": "Is your skin alive? The part you can see isn't: not one cell."
  },
  {
   "id": "vo02",
   "t": 5.433333333333334,
   "dur": 9.636,
   "file": "vo/02.wav",
   "text": "Look closer: the surface is a stack of flattened cells, more than a dozen deep, each an empty shell packed with keratin. The living ones start just underneath."
  },
  {
   "id": "vo03",
   "t": 15.7,
   "dur": 10.13,
   "file": "vo/03.wav",
   "text": "Every one of them began down there, alive, then rose for about two weeks, filling with keratin, until near the top it took itself apart. On purpose."
  },
  {
   "id": "vo04",
   "t": 26.433333333333334,
   "dur": 10.399,
   "file": "vo/04.wav",
   "text": "It looks like waste, waiting to flake away. But sealed together with fats, those shells build a kind of brick wall, and the wall keeps your water inside."
  },
  {
   "id": "vo05",
   "t": 39.5,
   "dur": 10.294,
   "file": "vo/05.wav",
   "text": "Babies born too early haven't finished theirs, and doctors measuring their skin found it losing water about five times as fast. That's how much the wall holds back."
  },
  {
   "id": "vo06",
   "t": 53.5,
   "dur": 5.782,
   "file": "vo/06.wav",
   "text": "And that whole wall, on a cheek, is thinner than a fifth of a sheet of paper."
  },
  {
   "id": "vo07",
   "t": 60.03333333333333,
   "dur": 5.946,
   "file": "vo/07.wav",
   "text": "So, is your skin alive? Underneath, yes. On top, it wears a layer that died for it."
  },
  {
   "id": "vo08",
   "t": 67.03333333333333,
   "dur": 4.537,
   "file": "vo/08.wav",
   "text": "Next: does SPF one hundred block twice as much as fifty?"
  }
 ]
}