 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 4.083,
   "file": "vo/01.wav",
   "text": "Bigger number, bigger shield? On a sunscreen, not the way you'd think."
  },
  {
   "id": "vo02",
   "t": 4.966666666666667,
   "dur": 8.007,
   "file": "vo/02.wav",
   "text": "The number isn't a percentage. It's a ratio: how much more burning light your skin can take under the film before it reddens."
  },
  {
   "id": "vo03",
   "t": 13.833333333333334,
   "dur": 8.414,
   "file": "vo/03.wav",
   "text": "Flip it, and fifty lets through about a fiftieth of that light, a hundred about a hundredth, which is barely more blocked."
  },
  {
   "id": "vo04",
   "t": 23.166666666666668,
   "dur": 8.512,
   "file": "vo/04.wav",
   "text": "But look at what actually gets in: the bigger number lets in half as much, if the film is as thick as the lab's."
  },
  {
   "id": "vo05",
   "t": 34.36666666666667,
   "dur": 9.536,
   "file": "vo/05.wav",
   "text": "Real people, studies found, spread a quarter to half as much as the lab, and protection falls well below the label, by an amount still argued over."
  },
  {
   "id": "vo06",
   "t": 47.43333333333333,
   "dur": 7.246,
   "file": "vo/06.wav",
   "text": "That lab layer is about as thick as the dead layer under it, a fifth of a sheet of paper."
  },
  {
   "id": "vo07",
   "t": 55.833333333333336,
   "dur": 7.206,
   "file": "vo/07.wav",
   "text": "So the bigger number doesn't block twice as much. It lets half as much in, when there's enough of it."
  },
  {
   "id": "vo08",
   "t": 64.23333333333333,
   "dur": 4.287,
   "file": "vo/08.wav",
   "text": "Next: why do fingers wrinkle in the bath, but not your arm?"
  }
 ]
