 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 4.083,
   "file": "vo/01.wav",
   "text": "Bigger number, bigger shield? On a sunscreen, not the way you'd think."
  },
  {
   "id": "vo02",
   "t": 4.966666666666667,
   "dur": 8.007,
   "file": "vo/02.wav",
   "text": "The number isn't a percentage. It's a ratio: how much more burning light your skin can take under the film before it reddens."
  },
  {
   "id": "vo03",
   "t": 13.833333333333334,
   "dur": 7.735,
   "file": "vo/03.wav",
   "text": "Flip it around, and both let only a thin sliver of that light through, so the bigger number blocks barely more."
  },
  {
   "id": "vo04",
   "t": 22.7,
   "dur": 9.362,
   "file": "vo/04.wav",
   "text": "But look at what actually gets in. Half as much. That's the real difference, as long as the film is as thick as the lab's."
  },
  {
   "id": "vo05",
   "t": 34.833333333333336,
   "dur": 8.643,
   "file": "vo/05.wav",
   "text": "But real people, studies found, spread a quarter to half as much, and protection falls well below the label. How far is still argued."
  },
  {
   "id": "vo06",
   "t": 47.43333333333333,
   "dur": 7.313,
   "file": "vo/06.wav",
   "text": "That lab layer is about as thick as the dead layer under it. A fifth of a sheet of paper."
  },
  {
   "id": "vo07",
   "t": 55.833333333333336,
   "dur": 6.961,
   "file": "vo/07.wav",
   "text": "So the bigger number isn't twice the shield. It's half the light getting in, when there's enough of it."
  },
  {
   "id": "vo08",
   "t": 63.766666666666666,
   "dur": 4.287,
   "file": "vo/08.wav",
   "text": "Next: why do fingers wrinkle in the bath, but not your arm?"
  }
