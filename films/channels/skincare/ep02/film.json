 "voice": [
  {
   "id": "vo01",
   "t": 0.06666666666666667,
   "dur": 4.587,
   "file": "vo/01.wav",
   "text": "Where's your glow from? Most light on your face goes inside you."
  },
  {
   "id": "vo02",
   "t": 5.433333333333334,
   "dur": 10.045,
   "file": "vo/02.wav",
   "text": "Only a few percent bounces off the top as a glint. Smooth, hydrated skin sends it back in one direction; dry skin scatters it into a dull haze."
  },
  {
   "id": "vo03",
   "t": 16.633333333333333,
   "dur": 8.03,
   "file": "vo/03.wav",
   "text": "But the glint isn't the glow. The rest slips in, bounces among cells and fibres, and a large share finds its way back out."
  },
  {
   "id": "vo04",
   "t": 25.966666666666665,
   "dur": 11.736,
   "file": "vo/04.wav",
   "text": "You might picture a glow sitting on the skin. But it's light that travelled through you, tinted by melanin and blood, and a rush of blood sends it back redder."
  },
  {
   "id": "vo05",
   "t": 40.43333333333333,
   "dur": 8.73,
   "file": "vo/05.wav",
   "text": "Asked to make strangers' faces look as healthy as they could, people turned up exactly that: the colour of blood, shining back through the skin."
  },
  {
   "id": "vo06",
   "t": 53.03333333333333,
   "dur": 6.71,
   "file": "vo/06.wav",
   "text": "Blue light gets barely a millimetre in, about ten sheets of paper; red light goes several times deeper."
  },
  {
   "id": "vo07",
   "t": 60.96666666666667,
   "dur": 7.36,
   "file": "vo/07.wav",
   "text": "So the glow isn't on your face. It's light that went inside you, met your blood, and came back."
  },
  {
   "id": "vo08",
   "t": 69.36666666666666,
   "dur": 5.306,
   "file": "vo/08.wav",
   "text": "Next: before birth, a cut healed without a trace. So why do you scar?"
  }
