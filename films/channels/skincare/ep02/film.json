 "voice": [
  {
   "id": "vo01",
   "t": 0.06666666666666667,
   "dur": 4.587,
   "file": "vo/01.wav",
   "text": "Where's your glow from? Most light on your face goes inside you."
  },
  {
   "id": "vo02",
   "t": 5.433333333333334,
   "dur": 9.497,
   "file": "vo/02.wav",
   "text": "Only about one ray in twenty bounces off as a glint. Smooth, hydrated skin sends it back one way; dry skin scatters it into a haze."
  },
  {
   "id": "vo03",
   "t": 16.166666666666668,
   "dur": 9.685,
   "file": "vo/03.wav",
   "text": "But the glint isn't the glow. The rest slips in, bounces among cells and fibres, and several times more finds its way back out."
  },
  {
   "id": "vo04",
   "t": 26.9,
   "dur": 8.813,
   "file": "vo/04.wav",
   "text": "You'd picture a glow as shine sitting on the skin. But it's light that has travelled through you, past your melanin and your blood."
  },
  {
   "id": "vo05",
   "t": 38.56666666666667,
   "dur": 10.434,
   "file": "vo/05.wav",
   "text": "Blood moves with your heart, so your face changes colour with every beat: too faint to see, but an ordinary camera can count your pulse in it."
  },
  {
   "id": "vo06",
   "t": 52.56666666666667,
   "dur": 7.505,
   "file": "vo/06.wav",
   "text": "And it goes deep: blue light barely a millimetre, about ten sheets of paper; red several times further, through the skin."
  },
  {
   "id": "vo07",
   "t": 60.96666666666667,
   "dur": 6.799,
   "file": "vo/07.wav",
   "text": "Film faces made by computer once looked like plastic: their light never went inside. Yours does; that's your glow."
  },
  {
   "id": "vo08",
   "t": 68.9,
   "dur": 5.306,
   "file": "vo/08.wav",
   "text": "Next: before birth, a cut healed without a trace. So why do you scar?"
  }
 ]
