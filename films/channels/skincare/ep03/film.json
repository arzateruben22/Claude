 "voice": [
  {
   "id": "vo01",
   "t": 0.03333333333333333,
   "dur": 4.431,
   "file": "vo/01.wav",
   "text": "Why do wet fingers wrinkle? Your arm stays smooth in the same bath."
  },
  {
   "id": "vo02",
   "t": 5.433333333333334,
   "dur": 8.187,
   "file": "vo/02.wav",
   "text": "It looks like skin soaking up water and swelling, like a sponge. It's the story we grew up with, and it's wrong."
  },
  {
   "id": "vo03",
   "t": 14.3,
   "dur": 8.58,
   "file": "vo/03.wav",
   "text": "Almost a century ago, doctors noticed something odd: a finger whose nerve had been cut stayed perfectly smooth in the bath."
  },
  {
   "id": "vo04",
   "t": 23.633333333333333,
   "dur": 10.256,
   "file": "vo/04.wav",
   "text": "So the wrinkles come from your nerves. In water, they narrow the tiny vessels under each fingertip, the pad shrinks a little, and the skin on top buckles."
  },
  {
   "id": "vo05",
   "t": 36.233333333333334,
   "dur": 10.688,
   "file": "vo/05.wav",
   "text": "A wrinkle is a reflex, one doctors use to test a nerve. Why we have it is argued: one study found a wet grip, the next found none."
  },
  {
   "id": "vo06",
   "t": 48.36666666666667,
   "dur": 8.643,
   "file": "vo/06.wav",
   "text": "It only happens on the hairless skin of hands and feet, which also carry the thickest dead layer, nearly two sheets of paper."
  },
  {
   "id": "vo07",
   "t": 57.7,
   "dur": 5.885,
   "file": "vo/07.wav",
   "text": "So your fingers don't wrinkle because they're soaked. They wrinkle because your nerves decide to."
  },
  {
   "id": "vo08",
   "t": 64.23333333333333,
   "dur": 3.871,
   "file": "vo/08.wav",
   "text": "Next: is a tan really a shield for your skin?"
  }
 ]
