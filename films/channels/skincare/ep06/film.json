 "voice": [
  {
   "id": "vo01",
   "t": 0.06666666666666667,
   "dur": 3.825,
   "file": "vo/01.wav",
   "text": "Same list as cigarettes? Most people hear: just as deadly."
  },
  {
   "id": "vo02",
   "t": 4.966666666666667,
   "dur": 11.304,
   "file": "vo/02.wav",
   "text": "It's the World Health Organization's cancer agency: tanning beds sit in its top group, beside tobacco smoke. That group ranks how sure the evidence is, not how big the harm."
  },
  {
   "id": "vo03",
   "t": 17.1,
   "dur": 10.896,
   "file": "vo/03.wav",
   "text": "Follow the evidence into the bed: its light is mostly UVA, the long rays. In large, powerful units, it may be ten to fifteen times as intense as the midday sun."
  },
  {
   "id": "vo04",
   "t": 29.233333333333334,
   "dur": 11.632,
   "file": "vo/04.wav",
   "text": "Weighing the studies, the agency's experts found the sharpest signal in people who started young. In pooled studies, starting before thirty-five went with a melanoma risk raised by more than half."
  },
  {
   "id": "vo05",
   "t": 43.7,
   "dur": 7.087,
   "file": "vo/05.wav",
   "text": "Then whole countries acted: Brazil banned commercial tanning beds that same year; later, Australia switched its own off."
  },
  {
   "id": "vo06",
   "t": 54.43333333333333,
   "dur": 6.31,
   "file": "vo/06.wav",
   "text": "And the long rays reach right through the top layer, on most skin about as thin as paper."
  },
  {
   "id": "vo07",
   "t": 61.9,
   "dur": 5.346,
   "file": "vo/07.wav",
   "text": "Same list as cigarettes, then: not the same size of harm, but the same certainty."
  },
  {
   "id": "vo08",
   "t": 68.43333333333334,
   "dur": 3.922,
   "file": "vo/08.wav",
   "text": "Next season: why do bath fingers wrinkle, but never your arm?"
  }
