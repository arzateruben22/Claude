 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 4.685,
   "file": "vo/01.wav",
   "text": "How long is a chain of us? Everyone on Earth, holding hands."
  },
  {
   "id": "vo02",
   "t": 5.7,
   "dur": 8.719,
   "file": "vo/02.wav",
   "text": "Stretch your arms out wide. You are about as wide as you are tall. Call it a meter and a half, for grown-ups and kids together."
  },
  {
   "id": "vo03",
   "t": 15.3,
   "dur": 11.381,
   "file": "vo/03.wav",
   "text": "Now add all eight billion people, one after another, hand in hand. Out past the horizon it goes, until the line is about thirteen million kilometers long."
  },
  {
   "id": "vo04",
   "t": 27.9,
   "dur": 8.423,
   "file": "vo/04.wav",
   "text": "That number is too big to picture. So let's wrap the line around something we all know: the Earth. Pull it tight, like a thread."
  },
  {
   "id": "vo05",
   "t": 38.7,
   "dur": 8.732,
   "file": "vo/05.wav",
   "text": "It circles the Earth about three hundred and thirty times. And one lap needs only one person in three hundred of us."
  },
  {
   "id": "vo06",
   "t": 51.3,
   "dur": 6.761,
   "file": "vo/06.wav",
   "text": "Make everyone a little shorter or taller, and the chain still wraps the Earth hundreds of times."
  },
  {
   "id": "vo07",
   "t": 59.1,
   "dur": 6.906,
   "file": "vo/07.wav",
   "text": "The same line would reach the Moon again and again. We are each small, but together we are very long."
  },
  {
   "id": "vo08",
   "t": 66.9,
   "dur": 4.426,
   "file": "vo/08.wav",
   "text": "Next envelope: a rope round the Earth, lifted one meter."
  }
 ]
}