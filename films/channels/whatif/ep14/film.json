 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 1.775,
   "file": "vo/01.wav",
   "text": "The day is shrinking fast."
  },
  {
   "id": "vo02",
   "t": 2.7333333333333334,
   "dur": 2.265,
   "file": "vo/02.wav",
   "text": "Now the spin begins to speed up."
  },
  {
   "id": "vo03",
   "t": 5.733333333333333,
   "dur": 3.173,
   "file": "vo/03.wav",
   "text": "At twenty hours, you can see the shadows sweep."
  },
  {
   "id": "vo04",
   "t": 9.666666666666666,
   "dur": 4.586,
   "file": "vo/04.wav",
   "text": "At sixteen, the Sun climbs the sky like a slow elevator."
  },
  {
   "id": "vo05",
   "t": 14.9,
   "dur": 4.281,
   "file": "vo/05.wav",
   "text": "A day only ever gets shorter, and you cannot turn it back."
  },
  {
   "id": "vo06",
   "t": 19.866666666666667,
   "dur": 4.409,
   "file": "vo/06.wav",
   "text": "At a twelve hour day, sunrise to sunset takes six hours."
  },
  {
   "id": "vo07",
   "t": 24.933333333333334,
   "dur": 7.096,
   "file": "vo/07.wav",
   "text": "At a twelve hour day the Sun moves across the sky as fast as the hour hand on a clock."
  },
  {
   "id": "vo08",
   "t": 32.733333333333334,
   "dur": 9.907,
   "file": "vo/08.wav",
   "text": "The ground under your feet now moves at about thirty-three hundred kilometers an hour, nearly three times the speed of sound."
  },
  {
   "id": "vo09",
   "t": 43.4,
   "dur": 6.97,
   "file": "vo/09.wav",
   "text": "You weigh one point four percent less than on a still Earth, four times what you feel today."
  },
  {
   "id": "vo10",
   "t": 51.13333333333333,
   "dur": 4.512,
   "file": "vo/10.wav",
   "text": "Quick break: like and follow. Then let's see how bad this gets."
  },
  {
   "id": "vo11",
   "t": 56.43333333333333,
   "dur": 3.795,
   "file": "vo/11.wav",
   "text": "Eight hours of sleep no longer fits inside one night."
  },
  {
   "id": "vo12",
   "t": 60.93333333333333,
   "dur": 1.958,
   "file": "vo/12.wav",
   "text": "And then the wind starts to blow."
  },
  {
   "id": "vo13",
   "t": 63.6,
   "dur": 3.218,
   "file": "vo/13.wav",
   "text": "Part two of eight. Full video on YouTube."
  }
 ]
