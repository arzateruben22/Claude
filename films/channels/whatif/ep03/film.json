 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 4.564,
   "file": "vo/01.wav",
   "text": "Ants, or us: who weighs more? Every ant on Earth, on one scale."
  },
  {
   "id": "vo02",
   "t": 5.7,
   "dur": 9.263,
   "file": "vo/02.wav",
   "text": "Decades ago, two of the world's great ant scientists sat down with this exact sum, and decided the scale would roughly balance."
  },
  {
   "id": "vo03",
   "t": 15.9,
   "dur": 10.114,
   "file": "vo/03.wav",
   "text": "Then a team gathered hundreds of real ant counts, from forests, deserts and cities, and found about twice as many ants as anyone had guessed."
  },
  {
   "id": "vo04",
   "t": 27.3,
   "dur": 12.315,
   "file": "vo/04.wav",
   "text": "So the ants should win. But a real ant is tinier than the old guess assumed, and once they're weighed properly, all of them together come to only about a fifth of us."
  },
  {
   "id": "vo05",
   "t": 42.3,
   "dur": 9.606,
   "file": "vo/05.wav",
   "text": "That's still more than every wild bird and mammal on Earth combined. And for each one of us, there are about two and a half million ants."
  },
  {
   "id": "vo06",
   "t": 55.5,
   "dur": 5.201,
   "file": "vo/06.wav",
   "text": "Take the heaviest estimate anyone has published, and we still win the scale."
  },
  {
   "id": "vo07",
   "t": 61.5,
   "dur": 5.165,
   "file": "vo/07.wav",
   "text": "So we win on the scale, by a lot. But they win on the count."
  },
  {
   "id": "vo08",
   "t": 67.5,
   "dur": 4.155,
   "file": "vo/08.wav",
   "text": "Next envelope: how long would it take to count to a billion?"
  }
 ]
}