 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 4.439,
   "file": "vo/01.wav",
   "text": "Could lightning power the world? Catch every bolt, for a whole year."
  },
  {
   "id": "vo02",
   "t": 5.7,
   "dur": 11.849,
   "file": "vo/02.wav",
   "text": "Lightning is flashing somewhere right now, about forty-four times every second, all around the planet. That adds up to more than a billion flashes in a year."
  },
  {
   "id": "vo03",
   "t": 18.3,
   "dur": 9.012,
   "file": "vo/03.wav",
   "text": "One flash carries roughly a billion joules, a rough guess with a wide range. Multiply it by every flash in the year."
  },
  {
   "id": "vo04",
   "t": 28.5,
   "dur": 12.252,
   "file": "vo/04.wav",
   "text": "That is about four hundred billion kilowatt-hours, a very big number. But a number only means something beside another, so let's compare it with what we use."
  },
  {
   "id": "vo05",
   "t": 41.7,
   "dur": 9.124,
   "file": "vo/05.wav",
   "text": "The world uses nearly eighty times more electricity in a year. All the lightning on Earth would run it for about five days."
  },
  {
   "id": "vo06",
   "t": 51.9,
   "dur": 8.071,
   "file": "vo/06.wav",
   "text": "If a flash holds ten times less or ten times more, it swings from half a day to about seven weeks."
  },
  {
   "id": "vo07",
   "t": 60.9,
   "dur": 7.37,
   "file": "vo/07.wav",
   "text": "And catching it is the real problem. The bolts are everywhere, and each is over in a split second."
  },
  {
   "id": "vo08",
   "t": 69.3,
   "dur": 3.409,
   "file": "vo/08.wav",
   "text": "Next envelope: a what-if that you ask us next."
  }
