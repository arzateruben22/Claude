 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 4.742,
   "file": "vo/01.wav",
   "text": "How long to walk to the Moon? Starting at your own front door."
  },
  {
   "id": "vo02",
   "t": 5.7,
   "dur": 7.583,
   "file": "vo/02.wav",
   "text": "The Moon sits about thirty Earths away, lined up side by side, with nothing but dark between."
  },
  {
   "id": "vo03",
   "t": 14.1,
   "dur": 8.495,
   "file": "vo/03.wav",
   "text": "Walk at an easy pace, the kind you could chat through. Never stop, not even to sleep. You would arrive in about nine years."
  },
  {
   "id": "vo04",
   "t": 23.7,
   "dur": 8.145,
   "file": "vo/04.wav",
   "text": "But nobody walks day and night. You sleep, you eat, you stop to tie a shoe. So give yourself a working day of walking."
  },
  {
   "id": "vo05",
   "t": 34.5,
   "dur": 4.669,
   "file": "vo/05.wav",
   "text": "A working day of walking gets you there in about twenty-six years."
  },
  {
   "id": "vo06",
   "t": 42.9,
   "dur": 12.514,
   "file": "vo/06.wav",
   "text": "Slower adds years, quicker trims a few. Ten thousand steps a day, the popular goal, is only about seven and a half kilometers. So that trip takes about a hundred and forty years."
  },
  {
   "id": "vo07",
   "t": 56.7,
   "dur": 7.804,
   "file": "vo/07.wav",
   "text": "Apollo eleven's crew made the same trip in about three days. The distance never changed, only the speed."
  },
  {
   "id": "vo08",
   "t": 65.7,
   "dur": 3.992,
   "file": "vo/08.wav",
   "text": "Next envelope: what if everyone on Earth held hands?"
  }
 ]
}