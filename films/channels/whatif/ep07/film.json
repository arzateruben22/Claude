 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 4.742,
   "file": "vo/01.wav",
   "text": "How long to walk to the Moon? Starting at your own front door."
  },
  {
   "id": "vo02",
   "t": 5.7,
   "dur": 10.807,
   "file": "vo/02.wav",
   "text": "The Moon sits about thirty Earths away, lined up side by side, with nothing but dark between. That is a very long way for a pair of shoes."
  },
  {
   "id": "vo03",
   "t": 17.7,
   "dur": 8.495,
   "file": "vo/03.wav",
   "text": "Walk at an easy pace, the kind you could chat through. Never stop, not even to sleep. You would arrive in about nine years."
  },
  {
   "id": "vo04",
   "t": 27.3,
   "dur": 8.145,
   "file": "vo/04.wav",
   "text": "But nobody walks day and night. You sleep, you eat, you stop to tie a shoe. So give yourself a working day of walking."
  },
  {
   "id": "vo05",
   "t": 38.1,
   "dur": 11.483,
   "file": "vo/05.wav",
   "text": "A working day of walking gets you there in about twenty-six years. Stick to the popular daily step goal, and it is closer to a hundred and forty."
  },
  {
   "id": "vo06",
   "t": 53.1,
   "dur": 4.727,
   "file": "vo/06.wav",
   "text": "Slower adds years, quicker trims a few, but it never gets close."
  },
  {
   "id": "vo07",
   "t": 59.1,
   "dur": 7.634,
   "file": "vo/07.wav",
   "text": "The Apollo crews made the same trip in about three days. The distance never changed, only the speed."
  },
  {
   "id": "vo08",
   "t": 67.5,
   "dur": 3.992,
   "file": "vo/08.wav",
   "text": "Next envelope: what if everyone on Earth held hands?"
  }
 ]
}