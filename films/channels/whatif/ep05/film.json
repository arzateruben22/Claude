 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 4.234,
   "file": "vo/01.wav",
   "text": "Would the Earth move? If all of us jumped, at once."
  },
  {
   "id": "vo02",
   "t": 5.1,
   "dur": 10.527,
   "file": "vo/02.wav",
   "text": "When you jump, you push the ground away, and the ground is the whole planet. So gather everyone into one crowd, all eight billion, and jump together."
  },
  {
   "id": "vo03",
   "t": 16.5,
   "dur": 7.734,
   "file": "vo/03.wav",
   "text": "For about half a second we're all in the air, and the planet, pushed the other way, drops away beneath our feet."
  },
  {
   "id": "vo04",
   "t": 25.5,
   "dur": 10.392,
   "file": "vo/04.wav",
   "text": "It sounds like it should knock the planet off course. But the push is shared out by weight, and the Earth outweighs all of us ten trillion times over."
  },
  {
   "id": "vo05",
   "t": 38.7,
   "dur": 10.354,
   "file": "vo/05.wav",
   "text": "So the whole planet moves a distance three thousand times smaller than a single atom. And when we land, it settles right back where it was."
  },
  {
   "id": "vo06",
   "t": 52.5,
   "dur": 6.664,
   "file": "vo/06.wav",
   "text": "Jump higher, or count us lighter, and it stays thousands of times smaller than an atom."
  },
  {
   "id": "vo07",
   "t": 60.3,
   "dur": 5.04,
   "file": "vo/07.wav",
   "text": "So yes, the Earth moves when we jump. It just never notices."
  },
  {
   "id": "vo08",
   "t": 66.3,
   "dur": 4.552,
   "file": "vo/08.wav",
   "text": "Next envelope: what if a whole day's rain fell in one second?"
  }
 ]
