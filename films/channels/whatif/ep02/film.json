 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 4.469,
   "file": "vo/01.wav",
   "text": "Could we fit in one city? All eight billion, with room to breathe."
  },
  {
   "id": "vo02",
   "t": 5.7,
   "dur": 9.862,
   "file": "vo/02.wav",
   "text": "There are a lot of us, and it can feel like the world is full. So give each person half a square meter, the room a calm crowd keeps."
  },
  {
   "id": "vo03",
   "t": 16.5,
   "dur": 9.529,
   "file": "vo/03.wav",
   "text": "Now bring everyone in, and the crowd keeps spreading, street after street, until it settles into a square you could drive across in under an hour."
  },
  {
   "id": "vo04",
   "t": 27.3,
   "dur": 13.747,
   "file": "vo/04.wav",
   "text": "You could squeeze us tighter, but packed twice as close, a crowd starts to move like a fluid, and that's when it turns dangerous. So we keep the room, and all of humanity still covers just two or three Londons."
  },
  {
   "id": "vo05",
   "t": 43.5,
   "dur": 9.867,
   "file": "vo/05.wav",
   "text": "From orbit, you'd struggle to find us. And packed like water, every body would fit in a cube a little shorter than the world's tallest tower."
  },
  {
   "id": "vo06",
   "t": 56.7,
   "dur": 5.06,
   "file": "vo/06.wav",
   "text": "Nudge how dense we are either way, and that cube barely changes size."
  },
  {
   "id": "vo07",
   "t": 62.7,
   "dur": 5.229,
   "file": "vo/07.wav",
   "text": "So the world isn't full. It only feels that way from inside a city."
  },
  {
   "id": "vo08",
   "t": 68.7,
   "dur": 3.707,
   "file": "vo/08.wav",
   "text": "Next envelope: who weighs more, all the ants or us?"
  }
 ]
