 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 4.142,
   "file": "vo/01.wav",
   "text": "A day's rain, all at once? Every drop, in one second."
  },
  {
   "id": "vo02",
   "t": 5.1,
   "dur": 11.275,
   "file": "vo/02.wav",
   "text": "On an ordinary day, the sky lets go of nearly a Great Lake, spread so thin across the hours you barely notice. It falls like eighty Amazons pouring from the clouds."
  },
  {
   "id": "vo03",
   "t": 17.1,
   "dur": 7.701,
   "file": "vo/03.wav",
   "text": "Now squeeze that whole day into a single second, and the sky pours like seven million Amazon rivers, all at once."
  },
  {
   "id": "vo04",
   "t": 26.1,
   "dur": 10.792,
   "file": "vo/04.wav",
   "text": "It sounds like the end of the world, a flood with nowhere to run. But that rain lands where it always lands, and most of it on the open ocean."
  },
  {
   "id": "vo05",
   "t": 39.3,
   "dur": 9.94,
   "file": "vo/05.wav",
   "text": "Spread over the whole planet, a day of the world's weather comes down as a layer about three millimeters deep. About two coins, stacked."
  },
  {
   "id": "vo06",
   "t": 53.1,
   "dur": 5.452,
   "file": "vo/06.wav",
   "text": "Use a wetter estimate of the world's rain, and it barely changes the depth."
  },
  {
   "id": "vo07",
   "t": 59.7,
   "dur": 6.602,
   "file": "vo/07.wav",
   "text": "So the whole sky's rain is a thin film, spread wide. A storm is where it piles up."
  },
  {
   "id": "vo08",
   "t": 67.5,
   "dur": 3.659,
   "file": "vo/08.wav",
   "text": "Next envelope: how long to walk to the Moon?"
  }
 ]
