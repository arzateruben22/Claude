 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 5.618,
   "file": "vo/01.wav",
   "text": "How much more rope? Round the whole Earth, lifted one meter off the ground."
  },
  {
   "id": "vo02",
   "t": 6.9,
   "dur": 9.715,
   "file": "vo/02.wav",
   "text": "Start with a rope that hugs the planet, about forty thousand kilometers long. Now lift it one meter above the ground, everywhere."
  },
  {
   "id": "vo03",
   "t": 17.7,
   "dur": 6.639,
   "file": "vo/03.wav",
   "text": "A whole planet of rope, lifted all at once. You might guess it needs thousands of kilometers more."
  },
  {
   "id": "vo04",
   "t": 25.5,
   "dur": 10.967,
   "file": "vo/04.wav",
   "text": "But a circle's length is two times pi times its radius, the distance to its center. Lift the rope a meter, and the radius grows a meter."
  },
  {
   "id": "vo05",
   "t": 39.3,
   "dur": 9.342,
   "file": "vo/05.wav",
   "text": "So the rope grows by two times pi times one meter, about six meters. That is about four of you, lying head to toe."
  },
  {
   "id": "vo06",
   "t": 52.5,
   "dur": 6.96,
   "file": "vo/06.wav",
   "text": "Try a basketball or the Sun: lift the rope one meter, and the extra rope is the same."
  },
  {
   "id": "vo07",
   "t": 60.3,
   "dur": 7.729,
   "file": "vo/07.wav",
   "text": "The planet's size cancels out: only the lift matters. Ten times higher needs ten times more rope."
  },
  {
   "id": "vo08",
   "t": 68.7,
   "dur": 4.264,
   "file": "vo/08.wav",
   "text": "Next envelope: a shuffled deck, and a very rare order."
  }
 ]
}