 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 5.608,
   "file": "vo/01.wav",
   "text": "How big is Earth's water? Gather every drop into one ball, and measure it."
  },
  {
   "id": "vo02",
   "t": 6.9,
   "dur": 11.946,
   "file": "vo/02.wav",
   "text": "Count the oceans, the ice, the lakes, the rivers, the water underground, and the water in the air. It adds up to about one point four billion cubic kilometers."
  },
  {
   "id": "vo03",
   "t": 19.5,
   "dur": 9.894,
   "file": "vo/03.wav",
   "text": "Squeeze all of it into one round ball, as if it were a single giant drop. That ball is about fourteen hundred kilometers wide."
  },
  {
   "id": "vo04",
   "t": 30.3,
   "dur": 7.95,
   "file": "vo/04.wav",
   "text": "That sounds enormous, and next to us it is. But our world is much bigger, so let's set the ball next to a planet."
  },
  {
   "id": "vo05",
   "t": 39.3,
   "dur": 7.028,
   "file": "vo/05.wav",
   "text": "It is less than half as wide as the Moon. Next to the Earth, it is a marble beside a basketball."
  },
  {
   "id": "vo06",
   "t": 47.1,
   "dur": 8.534,
   "file": "vo/06.wav",
   "text": "Only a small part of the water is fresh; count just that, and the ball is about four hundred kilometers wide."
  },
  {
   "id": "vo07",
   "t": 56.7,
   "dur": 8.177,
   "file": "vo/07.wav",
   "text": "Earth looks like a water world from space. But its water is only about an eighth of one percent of its volume."
  },
  {
   "id": "vo08",
   "t": 65.7,
   "dur": 3.857,
   "file": "vo/08.wav",
   "text": "Next envelope: could we catch all the world's lightning?"
  }
