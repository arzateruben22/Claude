 "voice": [
  {
   "id": "vo01",
   "t": 0.1,
   "dur": 5.143,
   "file": "vo/01.wav",
   "text": "How long to fall through the Earth? Down, down, and out the other side."
  },
  {
   "id": "vo02",
   "t": 5.966666666666667,
   "dur": 10.467,
   "file": "vo/02.wav",
   "text": "Picture a tunnel through the middle: no air, no heat. It's about twelve thousand seven hundred kilometers. Driving it nonstop at highway speed takes about five days. You'll be falling."
  },
  {
   "id": "vo03",
   "t": 17.3,
   "dur": 10.994,
   "file": "vo/03.wav",
   "text": "Gravity pulls you down, faster and faster. By the center: about ten kilometers a second. Then it slows you, and you reach the far side just as you stop."
  },
  {
   "id": "vo04",
   "t": 29.3,
   "dur": 13.158,
   "file": "vo/04.wav",
   "text": "The textbook answer was forty-two minutes. It assumed Earth is equally dense all the way down. Then a graduate student, Alexander Klotz, used the real Earth. The core is so dense that gravity gets stronger before it fades."
  },
  {
   "id": "vo05",
   "t": 44.96666666666667,
   "dur": 7.617,
   "file": "vo/05.wav",
   "text": "His answer: about thirty-eight minutes. With nothing to stop you, you'd fall back and forth, a round trip every seventy-six minutes, forever."
  },
  {
   "id": "vo06",
   "t": 55.96666666666667,
   "dur": 6.003,
   "file": "vo/06.wav",
   "text": "Show your work. Make the core ten percent lighter: about thirty-nine. Make Earth uniform: forty-two."
  },
  {
   "id": "vo07",
   "t": 62.96666666666667,
   "dur": 4.324,
   "file": "vo/07.wav",
   "text": "So those four missing minutes? They're the pull of Earth's heavy core."
  },
  {
   "id": "vo08",
   "t": 67.96666666666667,
   "dur": 4.092,
   "file": "vo/08.wav",
   "text": "Next envelope: could all eight billion of us stand in one city?"
  }
 ]
}