 "voice": [
  {
   "id": "vo01",
   "t": 0.3,
   "dur": 18.118,
   "file": "vo/01.wav",
   "text": "What if the Earth started to spin faster, a little more every second, and nothing in the universe could stop it? You are standing on the equator, and you are going to watch what happens, minute by minute, until the planet can't take it anymore."
  },
  {
   "id": "vo02",
   "t": 19.5,
   "dur": 25.053,
   "file": "vo/02.wav",
   "text": "Right now, one day lasts twenty-four hours. Standing on the equator, the ground carries you around at about sixteen hundred and seventy kilometers an hour. You never feel it, because everything moves with you. What you do feel is a tiny push outward. You weigh about a third of a percent less than you would on a planet that did not spin."
  },
  {
   "id": "vo03",
   "t": 45.3,
   "dur": 17.2,
   "file": "vo/03.wav",
   "text": "Now the spin begins to speed up. At twenty hours, you can see the shadows sweep. At sixteen, the Sun climbs the sky like a slow elevator. The rule never changes. A day only ever gets shorter, and you cannot turn it back."
  },
  {
   "id": "vo04",
   "t": 63.3,
   "dur": 2.904,
   "file": "vo/04.wav",
   "text": "And at twelve hours, it gets much stranger."
  },
  {
   "id": "vo05",
   "t": 66.9,
   "dur": 1.624,
   "file": "vo/05.wav",
   "text": "Full video on YouTube."
  }
 ]
