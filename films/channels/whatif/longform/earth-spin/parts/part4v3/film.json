   "file": "vo/01.wav",
   "text": "The oceans are sliding toward the equator."
  },
  {
   "id": "vo02",
   "t": 4.733333333333333,
   "dur": 4.23,
   "file": "vo/02.wav",
   "text": "A spinning planet pushes water outward, toward the equator, exactly as it pushes you."
  },
  {
   "id": "vo03",
   "t": 10.0,
   "dur": 4.326,
   "file": "vo/03.wav",
   "text": "At a twelve hour day the sea wants to stand about twenty miles higher at the equator."
  },
  {
   "id": "vo04",
   "t": 16.3,
   "dur": 2.705,
   "file": "vo/04.wav",
   "text": "The ocean is only about two point three miles deep."
  },
  {
   "id": "vo05",
   "t": 20.933333333333334,
   "dur": 3.26,
   "file": "vo/05.wav",
   "text": "So it drains toward a belt around the equator, and the poles dry out."
  },
  {
   "id": "vo06",
   "t": 25.166666666666668,
   "dur": 5.02,
   "file": "vo/06.wav",
   "text": "A rough first guess, but the direction is certain: land near the poles emerges, and your own coast floods."
  },
  {
   "id": "vo07",
   "t": 31.733333333333334,
   "dur": 3.34,
   "file": "vo/07.wav",
   "text": "And the weather is about to change completely."
  },
