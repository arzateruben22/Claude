 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 3.41,
   "file": "vo/01.wav",
   "text": "The oceans are sliding toward the equator."
  },
  {
   "id": "vo02",
   "t": 4.7,
   "dur": 1.58,
   "file": "vo/02.wav",
   "text": "And then the oceans begin to move."
  },
  {
   "id": "vo03",
   "t": 7.233333333333333,
   "dur": 5.37,
   "file": "vo/03.wav",
   "text": "A spinning planet pushes water outward, toward the equator, exactly as it pushes you."
  },
  {
   "id": "vo04",
   "t": 13.533333333333333,
   "dur": 7.59,
   "file": "vo/04.wav",
   "text": "Today the Earth already bulges about twenty-one kilometers wider at the equator than from pole to pole, and the ground has had billions of years to settle into that shape."
  },
  {
   "id": "vo05",
   "t": 22.1,
   "dur": 2.5,
   "file": "vo/05.wav",
   "text": "Speed the spin up quickly and the ground cannot adjust in time."
  },
  {
   "id": "vo06",
   "t": 25.533333333333335,
   "dur": 5.41,
   "file": "vo/06.wav",
   "text": "At a twelve hour day, the water wants to stand about thirty-three kilometers higher at the equator than at the poles, extra, compared with today."
  },
  {
   "id": "vo07",
   "t": 31.833333333333332,
   "dur": 3.84,
   "file": "vo/07.wav",
   "text": "The whole ocean is only about three point seven kilometers deep."
  },
  {
   "id": "vo08",
   "t": 36.666666666666664,
   "dur": 1.77,
   "file": "vo/08.wav",
   "text": "So the water does not simply rise."
  },
  {
   "id": "vo09",
   "t": 39.333333333333336,
   "dur": 3.03,
   "file": "vo/09.wav",
   "text": "It drains toward a belt around the equator, while the poles dry out."
  },
  {
   "id": "vo10",
   "t": 43.233333333333334,
   "dur": 5.92,
   "file": "vo/10.wav",
   "text": "This is a rough, first guess, but the direction is certain: land near the poles emerges, and your own coast is flooded."
  },
  {
   "id": "vo11",
   "t": 50.266666666666666,
   "dur": 3.04,
   "file": "vo/11.wav",
   "text": "Quick break: like and follow. Then let's see how bad this gets."
  },
  {
   "id": "vo12",
   "t": 54.333333333333336,
   "dur": 2.04,
   "file": "vo/12.wav",
   "text": "And the weather is about to change completely."
  },
  {
   "id": "vo13",
   "t": 57.3,
   "dur": 2.58,
   "file": "vo/13.wav",
   "text": "Part four of eight. Full video on YouTube."
  }
 ]
