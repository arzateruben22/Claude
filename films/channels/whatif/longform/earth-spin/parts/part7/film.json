 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 3.62,
   "file": "vo/01.wav",
   "text": "Three hours, then two: a day is as long as a movie."
  },
  {
   "id": "vo02",
   "t": 4.4,
   "dur": 4.957,
   "file": "vo/02.wav",
   "text": "At a three hour day, the Sun crosses the sky in just ninety minutes."
  },
  {
   "id": "vo03",
   "t": 9.8,
   "dur": 3.489,
   "file": "vo/03.wav",
   "text": "It slides its own width every sixteen seconds."
  },
  {
   "id": "vo04",
   "t": 13.7,
   "dur": 5.111,
   "file": "vo/04.wav",
   "text": "The ground now moves at over thirteen thousand kilometers an hour."
  },
  {
   "id": "vo05",
   "t": 19.266666666666666,
   "dur": 2.2,
   "file": "vo/05.wav",
   "text": "You weigh twenty-two percent less."
  },
  {
   "id": "vo06",
   "t": 21.933333333333334,
   "dur": 2.48,
   "file": "vo/06.wav",
   "text": "Seventy kilograms feels like fifty-five."
  },
  {
   "id": "vo07",
   "t": 24.933333333333334,
   "dur": 2.709,
   "file": "vo/07.wav",
   "text": "At two hours, you weigh half of what you did."
  },
  {
   "id": "vo08",
   "t": 28.1,
   "dur": 6.001,
   "file": "vo/08.wav",
   "text": "The same jump that lifts you half a meter today would now lift you about a meter."
  },
  {
   "id": "vo09",
   "t": 34.53333333333333,
   "dur": 6.083,
   "file": "vo/09.wav",
   "text": "Twenty thousand kilometers an hour; the Sun crosses the whole sky in an hour."
  },
  {
   "id": "vo10",
   "t": 41.13333333333333,
   "dur": 4.787,
   "file": "vo/10.wav",
   "text": "Every object near the equator is half as heavy as it should be."
  },
  {
   "id": "vo11",
   "t": 46.4,
   "dur": 5.98,
   "file": "vo/11.wav",
   "text": "Buildings, bridges and oceans are all being asked to hold on with half the force."
  },
  {
   "id": "vo12",
   "t": 52.93333333333333,
   "dur": 6.197,
   "file": "vo/12.wav",
   "text": "Hang on. If you're enjoying this, tap like and follow. Okay, back to the math."
  },
  {
   "id": "vo13",
   "t": 59.6,
   "dur": 3.15,
   "file": "vo/13.wav",
   "text": "And at an hour and a half, you are almost weightless."
  },
  {
   "id": "vo14",
   "t": 63.13333333333333,
   "dur": 3.349,
   "file": "vo/14.wav",
   "text": "Part seven of eight. Full video on YouTube."
  }
 ]
