 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 4.313,
   "file": "vo/01.wav",
   "text": "Storms are turning faster, and the days are six hours long."
  },
  {
   "id": "vo02",
   "t": 5.0,
   "dur": 2.058,
   "file": "vo/02.wav",
   "text": "The sky has another problem."
  },
  {
   "id": "vo03",
   "t": 7.4,
   "dur": 8.805,
   "file": "vo/03.wav",
   "text": "Storms are steered by the planet's spin, through the Coriolis effect, and that steering grows in step with the spin rate."
  },
  {
   "id": "vo04",
   "t": 16.533333333333335,
   "dur": 4.058,
   "file": "vo/04.wav",
   "text": "At a six hour day it is four times stronger than today."
  },
  {
   "id": "vo05",
   "t": 20.9,
   "dur": 4.016,
   "file": "vo/05.wav",
   "text": "At the edge of floating, it is seventeen times stronger."
  },
  {
   "id": "vo06",
   "t": 25.266666666666666,
   "dur": 8.538,
   "file": "vo/06.wav",
   "text": "Weather systems would be squeezed into tight, fast bands, and the calm of an ordinary afternoon would be gone."
  },
  {
   "id": "vo07",
   "t": 34.233333333333334,
   "dur": 5.054,
   "file": "vo/07.wav",
   "text": "Nobody could forecast it, because nobody has seen a planet like this."
  },
  {
   "id": "vo08",
   "t": 39.666666666666664,
   "dur": 5.96,
   "file": "vo/08.wav",
   "text": "At a six hour day, the Sun races from horizon to horizon in three hours."
  },
  {
   "id": "vo09",
   "t": 45.93333333333333,
   "dur": 4.818,
   "file": "vo/09.wav",
   "text": "The equator moves at nearly seven thousand kilometers an hour."
  },
  {
   "id": "vo10",
   "t": 51.2,
   "dur": 2.471,
   "file": "vo/10.wav",
   "text": "You are five and a half percent lighter."
  },
  {
   "id": "vo11",
   "t": 54.13333333333333,
   "dur": 6.197,
   "file": "vo/11.wav",
   "text": "Hang on. If you're enjoying this, tap like and follow. Okay, back to the math."
  },
  {
   "id": "vo12",
   "t": 60.8,
   "dur": 6.524,
   "file": "vo/12.wav",
   "text": "Jumping now takes you noticeably higher than it should, and every step feels slightly wrong."
  },
  {
   "id": "vo13",
   "t": 67.7,
   "dur": 2.26,
   "file": "vo/13.wav",
   "text": "And the calendar is about to break."
  },
  {
   "id": "vo14",
   "t": 70.33333333333333,
   "dur": 3.3,
   "file": "vo/14.wav",
   "text": "Part five of eight. Full video on YouTube."
  }
 ]
