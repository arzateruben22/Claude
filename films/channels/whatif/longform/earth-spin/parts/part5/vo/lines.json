  {
   "id": "vo01",
   "beat": "open",
   "text": "Storms are turning faster, and the days are six hours long.",
   "stars": [],
   "phonemes": null,
   "file": "01.wav",
   "dur": 2.73,
   "sha256": "316899d12c33ad0aee9da76ea7a50802465b17a16dd45f68ccc8f4b1732b8628"
  },
  {
   "id": "vo02",
   "beat": "weather-1",
   "text": "The sky has another problem.",
   "stars": [],
   "phonemes": null,
