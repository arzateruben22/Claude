 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 3.35,
   "file": "vo/01.wav",
   "text": "The air can't keep up with the ground."
  },
  {
   "id": "vo02",
   "t": 5.333333333333333,
   "dur": 3.39,
   "file": "vo/02.wav",
   "text": "It is pulled along only by friction, so for the first hours it is left behind."
  },
  {
   "id": "vo03",
   "t": 9.7,
   "dur": 3.61,
   "file": "vo/03.wav",
   "text": "The ground moves through it at about a thousand and forty miles an hour."
  },
  {
   "id": "vo04",
   "t": 15.7,
   "dur": 4.233,
   "file": "vo/04.wav",
   "text": "The strongest gust ever measured was about two hundred and fifty miles an hour."
  },
  {
   "id": "vo05",
   "t": 22.3,
   "dur": 6.54,
   "file": "vo/05.wav",
   "text": "This wind would be four times faster, blowing from the east, because the ground is running ahead of the air."
  },
  {
   "id": "vo06",
   "t": 29.8,
   "dur": 3.05,
   "file": "vo/06.wav",
   "text": "Winds like that would strip the surface, and they'd only be the beginning."
  },
  {
   "id": "vo07",
   "t": 34.666666666666664,
   "dur": 2.29,
   "file": "vo/07.wav",
   "text": "If you're enjoying this, tap like and follow."
  },
  {
   "id": "vo08",
   "t": 37.9,
   "dur": 3.11,
   "file": "vo/08.wav",
   "text": "And then the oceans start to move."
  }
 ]
