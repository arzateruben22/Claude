 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 3.99,
   "file": "vo/01.wav",
   "text": "Three hours, then two. A day is as long as a movie."
  },
  {
   "id": "vo02",
   "t": 5.2,
   "dur": 5.39,
   "file": "vo/02.wav",
   "text": "At a three hour day the Sun crosses the sky in ninety minutes, sliding its own width every sixteen seconds."
  },
  {
   "id": "vo03",
   "t": 11.5,
   "dur": 3.2,
   "file": "vo/03.wav",
   "text": "The ground moves at about eighty-three hundred miles an hour."
  },
  {
   "id": "vo04",
   "t": 16.6,
   "dur": 5.587,
   "file": "vo/04.wav",
   "text": "You weigh twenty-two percent less: a hundred and fifty pounds feels like a hundred and seventeen."
  },
  {
   "id": "vo05",
   "t": 24.1,
   "dur": 1.24,
   "file": "vo/05.wav",
   "text": "At two hours, you weigh half."
  },
  {
   "id": "vo06",
   "t": 26.333333333333332,
   "dur": 3.78,
   "file": "vo/06.wav",
   "text": "The jump that lifts you a foot and a half now lifts you about three feet."
  },
  {
   "id": "vo07",
   "t": 32.03333333333333,
   "dur": 1.92,
   "file": "vo/07.wav",
   "text": "The Sun crosses the whole sky in an hour."
  },
  {
   "id": "vo08",
   "t": 34.9,
   "dur": 6.88,
   "file": "vo/08.wav",
   "text": "Every object near the equator is half as heavy as it should be, and buildings, bridges and oceans must hold on with half the force."
  },
  {
   "id": "vo09",
   "t": 42.733333333333334,
   "dur": 2.29,
   "file": "vo/09.wav",
   "text": "If you're enjoying this, tap like and follow."
  },
  {
   "id": "vo10",
   "t": 46.0,
   "dur": 3.51,
   "file": "vo/10.wav",
   "text": "At an hour and a half, you're almost weightless."
  }
 ]
