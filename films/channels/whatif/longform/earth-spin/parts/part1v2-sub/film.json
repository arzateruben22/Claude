 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 3.51,
   "file": "vo/01.wav",
   "text": "What if Earth spun faster, and couldn't stop?"
  },
  {
   "id": "vo02",
   "t": 4.733333333333333,
   "dur": 5.11,
   "file": "vo/02.wav",
   "text": "You're standing on the equator, and you'll watch what happens minute by minute, until the planet can't take it anymore."
  },
  {
   "id": "vo03",
   "t": 10.733333333333333,
   "dur": 2.76,
   "file": "vo/03.wav",
   "text": "The Earth keeps its size, its air and its water."
  },
  {
   "id": "vo04",
   "t": 14.5,
   "dur": 2.38,
   "file": "vo/04.wav",
   "text": "Only the spin changes, and it only gets faster."
  },
  {
   "id": "vo05",
   "t": 17.8,
   "dur": 1.975,
   "file": "vo/05.wav",
   "text": "One number matters: the length of a day."
  },
  {
   "id": "vo06",
   "t": 20.8,
   "dur": 3.58,
   "file": "vo/06.wav",
   "text": "It starts at twenty-four hours and ends at about an hour and twenty-four minutes."
  },
  {
   "id": "vo07",
   "t": 25.3,
   "dur": 2.26,
   "file": "vo/07.wav",
   "text": "Under it, how fast the ground moves under your feet."
  },
  {
   "id": "vo08",
   "t": 28.6,
   "dur": 1.0,
   "file": "vo/08.wav",
   "text": "Nothing resets."
  },
  {
   "id": "vo09",
   "t": 30.533333333333335,
   "dur": 0.86,
   "file": "vo/09.wav",
   "text": "Nothing slows."
  },
  {
   "id": "vo10",
   "t": 32.333333333333336,
   "dur": 1.65,
   "file": "vo/10.wav",
   "text": "Treat every number as a first guess."
  },
  {
   "id": "vo11",
   "t": 34.9,
   "dur": 4.54,
   "file": "vo/11.wav",
   "text": "Right now the ground carries you at about sixteen hundred and seventy kilometers an hour."
  },
  {
   "id": "vo12",
   "t": 40.46666666666667,
   "dur": 4.83,
   "file": "vo/12.wav",
   "text": "What you feel is a tiny push outward: the spin makes you about a third of a percent lighter."
  },
  {
   "id": "vo13",
   "t": 46.333333333333336,
   "dur": 5.11,
   "file": "vo/13.wav",
   "text": "Hang on. If you're enjoying this, tap like and follow. Okay, back to the math."
  },
  {
   "id": "vo14",
   "t": 52.46666666666667,
   "dur": 3.43,
   "file": "vo/14.wav",
   "text": "And then the spin has only just begun to speed up."
  },
  {
   "id": "vo15",
   "t": 56.7,
   "dur": 3.35,
   "file": "vo/15.wav",
   "text": "Part one of eight. Full video on YouTube."
  }
 ]
