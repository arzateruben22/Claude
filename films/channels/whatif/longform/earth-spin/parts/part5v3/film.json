 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 4.3,
   "file": "vo/01.wav",
   "text": "Storms are turning faster, and the days are six hours long."
  },
  {
   "id": "vo02",
   "t": 5.5,
   "dur": 3.79,
   "file": "vo/02.wav",
   "text": "Storms are steered by the spin, and that steering grows with the spin rate."
  },
  {
   "id": "vo03",
   "t": 10.3,
   "dur": 2.39,
   "file": "vo/03.wav",
   "text": "At a six hour day it is four times stronger than today."
  },
  {
   "id": "vo04",
   "t": 13.6,
   "dur": 2.17,
   "file": "vo/04.wav",
   "text": "At the edge of floating, seventeen times."
  },
  {
   "id": "vo05",
   "t": 16.733333333333334,
   "dur": 5.41,
   "file": "vo/05.wav",
   "text": "The calm of an ordinary afternoon would be gone, and nobody could forecast it, because nobody has seen a planet like this."
  },
  {
   "id": "vo06",
   "t": 23.066666666666666,
   "dur": 7.69,
   "file": "vo/06.wav",
   "text": "At a six hour day the Sun crosses from horizon to horizon in three hours."
  },
  {
   "id": "vo07",
   "t": 31.733333333333334,
   "dur": 3.893,
   "file": "vo/07.wav",
   "text": "The equator moves at about forty-one hundred and fifty miles an hour."
  },
  {
   "id": "vo08",
   "t": 37.6,
   "dur": 2.16,
   "file": "vo/08.wav",
   "text": "You are five and a half percent lighter."
  },
  {
   "id": "vo09",
   "t": 40.733333333333334,
   "dur": 3.12,
   "file": "vo/09.wav",
   "text": "Jumping takes you higher than it should, and every step feels slightly wrong."
  },
  {
   "id": "vo10",
   "t": 44.833333333333336,
   "dur": 2.29,
   "file": "vo/10.wav",
   "text": "If you're enjoying this, tap like and follow."
  },
  {
