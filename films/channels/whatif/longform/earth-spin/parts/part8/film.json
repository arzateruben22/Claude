   "dur": 2.655,
   "file": "vo/03.wav",
   "text": "You weigh about one eighth of what you did."
  },
  {
   "id": "vo04",
   "t": 11.466666666666667,
   "dur": 4.561,
   "file": "vo/04.wav",
   "text": "A seventy kilogram person would weigh about eight kilograms."
  },
  {
   "id": "vo05",
   "t": 17.0,
   "dur": 8.881,
   "file": "vo/05.wav",
   "text": "The same jump that lifts you half a meter today would carry you about four meters, higher than a basketball hoop."
  },
  {
   "id": "vo06",
   "t": 26.733333333333334,
   "dur": 5.492,
   "file": "vo/06.wav",
   "text": "A cup falling off a table would take about three times as long to land."
  },
  {
   "id": "vo07",
   "t": 33.2,
   "dur": 4.767,
   "file": "vo/07.wav",
   "text": "The equator moves at twenty-seven thousand kilometers an hour."
