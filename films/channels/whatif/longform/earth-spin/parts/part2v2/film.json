 "voice": [
  {
   "id": "vo01",
   "t": 0.2,
   "dur": 3.03,
   "file": "vo/01.wav",
   "text": "The day is now twelve hours long."
  },
  {
   "id": "vo02",
   "t": 4.3,
   "dur": 1.28,
   "file": "vo/02.wav",
   "text": "Now the spin speeds up."
  },
  {
   "id": "vo03",
   "t": 6.533333333333333,
   "dur": 1.65,
   "file": "vo/03.wav",
   "text": "At twenty hours the shadows sweep."
  },
  {
   "id": "vo04",
   "t": 9.1,
   "dur": 2.65,
   "file": "vo/04.wav",
   "text": "At sixteen, the Sun climbs like a slow elevator."
  },
  {
   "id": "vo05",
   "t": 12.7,
   "dur": 2.74,
   "file": "vo/05.wav",
   "text": "A day only ever gets shorter, and you can't turn it back."
  },
  {
   "id": "vo06",
   "t": 16.466666666666665,
   "dur": 3.18,
   "file": "vo/06.wav",
   "text": "At a twelve hour day, sunrise to sunset takes six hours."
  },
  {
   "id": "vo07",
   "t": 20.666666666666668,
   "dur": 2.38,
   "file": "vo/07.wav",
   "text": "The Sun moves as fast as a clock's hour hand."
  },
  {
   "id": "vo08",
   "t": 23.933333333333334,
   "dur": 4.65,
   "file": "vo/08.wav",
   "text": "The ground moves at about thirty-three hundred kilometers an hour, nearly three times the speed of sound."
  },
  {
   "id": "vo09",
   "t": 29.5,
   "dur": 3.4,
   "file": "vo/09.wav",
   "text": "You are one point four percent lighter, four times what you feel today."
  },
  {
   "id": "vo10",
   "t": 33.86666666666667,
   "dur": 2.37,
   "file": "vo/10.wav",
   "text": "Eight hours of sleep no longer fits inside one night."
  },
  {
   "id": "vo11",
   "t": 37.13333333333333,
   "dur": 1.17,
   "file": "vo/11.wav",
   "text": "But the air can't keep up."
  },
  {
   "id": "vo12",
   "t": 39.266666666666666,
   "dur": 3.39,
   "file": "vo/12.wav",
   "text": "It is pulled along only by friction, so for the first hours it is left behind."
  },
  {
   "id": "vo13",
   "t": 43.6,
   "dur": 3.67,
   "file": "vo/13.wav",
   "text": "The ground moves through it at about sixteen hundred and seventy kilometers an hour."
  },
  {
   "id": "vo14",
   "t": 48.3,
