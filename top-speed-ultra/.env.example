# The game's store settings, read when the game is built (src/store/config.ts). With any of them missing, or
# VITE_PAYMENTS_LIVE anything but "true", the store runs in TEST MODE: nothing is charged and nothing leaves the
# browser. Copy this file to .env.production.local (git ignores it) and fill it in only when you go live
# (server/README.md, step 8). Vite puts every VITE_ value into the page where anyone can read it, so only the
# public anon/publishable key goes here: never the service-role key, a secret key or anything from Stripe.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYMENTS_LIVE=false
