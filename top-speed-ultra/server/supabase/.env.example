# Secrets for the two Edge Functions (server/README.md, steps 5 and 7). Copy to server/supabase/.env (git ignores it),
# fill in, then: npx supabase@latest secrets set --env-file supabase/.env   (from top-speed-ultra/server)
# Never commit the filled-in file, and never put any of these in the game or a VITE_ variable.

# Stripe secret key: sk_test_... until you decide to go live (step 10), then sk_live_...
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# The webhook endpoint's signing secret (whsec_...). Test and live endpoints have different ones.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# The page players play on; Stripe sends them back here (?checkout=success or ?checkout=cancel is added)
SITE_URL=https://REPLACE-ME.github.io/
# Origins allowed to call create-checkout from a browser (comma-separated, no paths)
ALLOWED_ORIGINS=https://REPLACE-ME.github.io
# Optional: pin Stripe's API version (otherwise the account's default is used)
# STRIPE_API_VERSION=
# Optional: only if the project has no legacy service_role key, the newer sb_secret_... key
# STORE_SERVICE_KEY=
