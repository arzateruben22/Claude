[Unit]
Description=Majors Desk, 4-hour rulebook: the same coins on 4-hour candles, its own paper bank
After=network-online.target
Wants=network-online.target

[Service]
Environment=PYTHONUNBUFFERED=1
User=@USER@
WorkingDirectory=@DIR@/majors-desk
ExecStart=@DIR@/.venv/bin/python -m majors run --book 4h
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
