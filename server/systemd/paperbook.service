[Unit]
Description=Paper Book, Trade Crawler and Paper Galaxy: every paper trade, refreshed every 15 minutes, shown on port 8790
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@/paper-book
ExecStart=@DIR@/.venv/bin/python paperbook.py --watch 15 --serve 8790
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
