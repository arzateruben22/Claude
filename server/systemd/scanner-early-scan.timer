[Unit]
Description=Early-rules scanner runs, a few minutes after the main scans so they don't hit Alpaca at once

[Timer]
OnCalendar=Mon..Fri *-*-* 17:06:00 America/Los_Angeles
OnCalendar=Mon..Fri *-*-* 05:39:00 America/Los_Angeles
OnCalendar=Mon..Fri *-*-* 06:06:00 America/Los_Angeles

[Install]
WantedBy=timers.target
