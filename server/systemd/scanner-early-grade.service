[Unit]
Description=Premarket scanner, early rules: grade today's paper picks, then the nightly review
After=network-online.target
Wants=network-online.target
ConditionPathExists=@DIR@/premarket-scanner/.env

[Service]
Environment=PYTHONUNBUFFERED=1
Type=oneshot
User=@USER@
WorkingDirectory=@DIR@/premarket-scanner
ExecStart=@DIR@/.venv/bin/python -m scanner grade --book early
ExecStart=@DIR@/.venv/bin/python -m scanner nightly --book early
