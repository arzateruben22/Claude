[Unit]
Description=Night Desk: the paper-money coin desk on live prices (main and wild rulebooks, one shared feed)
After=network-online.target
Wants=network-online.target

[Service]
Environment=PYTHONUNBUFFERED=1
User=@USER@
WorkingDirectory=@DIR@/night-desk
ExecStart=@DIR@/.venv/bin/python -m nightdesk run --no-browser --with wild
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
