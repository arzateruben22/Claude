[Unit]
Description=Premarket scanner: pick gap-up stocks (paper)
After=network-online.target
Wants=network-online.target
# Waits for your Alpaca paper keys in premarket-scanner/.env
ConditionPathExists=@DIR@/premarket-scanner/.env

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@DIR@/premarket-scanner
ExecStart=@DIR@/.venv/bin/python -m scanner scan --notify
