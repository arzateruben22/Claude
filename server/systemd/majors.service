[Unit]
Description=Majors Desk: paper trading on big coins (Coinbase) and stocks held for days (Alpaca daily bars), eight rulebooks
After=network-online.target
Wants=network-online.target

[Service]
Environment=PYTHONUNBUFFERED=1
User=@USER@
WorkingDirectory=@DIR@/majors-desk
ExecStart=@DIR@/.venv/bin/python -m majors run --book daily --with slow --with loose --with trend --with rush --with index --with sectors --with leaders
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
