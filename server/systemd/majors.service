[Unit]
Description=Majors Desk: paper trading on BTC, ETH and other big coins (four rulebooks, one Coinbase feed)
After=network-online.target
Wants=network-online.target

[Service]
Environment=PYTHONUNBUFFERED=1
User=@USER@
WorkingDirectory=@DIR@/majors-desk
ExecStart=@DIR@/.venv/bin/python -m majors run --book daily --with slow --with loose --with trend
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
